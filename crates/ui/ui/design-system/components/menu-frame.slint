// MenuFrame (§ 5.16, § 3.8): the level-1 surface of menus, select lists and popovers, with `menu-pad` inside. Free
// content: a `MenuList`, the map's options rows, a header line.

import { Size } from "../tokens/size.slint";
import { PopupSurface } from "../primitives/popup-surface.slint";

export component MenuFrame inherits PopupSurface {
    inset-x: Size.menu-pad;
    inset-y: Size.menu-pad;
}

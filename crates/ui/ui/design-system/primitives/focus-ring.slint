// The keyboard focus ring (§ 3.7): `border-focus` wide in `focus`, `focus-gap` outside the control's edge,
// following its radius. Placed inside the control at the control's size; the ring is drawn outside it.
//
// Not a component of the design system: screens never use it (it is not exported from `index.slint`).

import { Size } from "../tokens/size.slint";
import { Theme } from "../tokens/theme.slint";

export component FocusRing {
    // The control's own radius.
    in property <length> radius;

    // Laid over the control that holds it, at its size.
    width: 100%;
    height: 100%;

    property <length> outset: Size.focus-gap + Size.border-focus;

    Rectangle {
        x: -root.outset;
        y: -root.outset;
        width: root.width + 2 * root.outset;
        height: root.height + 2 * root.outset;
        border-width: Size.border-focus;
        border-color: Theme.focus;
        border-radius: root.radius + root.outset;
    }
}

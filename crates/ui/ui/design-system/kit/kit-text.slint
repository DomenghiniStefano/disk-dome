// The Kit's «Text and digits» section (§ 12 test 7, decision 8): the 12–13 px steps and a tree total,
// right-aligned figures that stay in columns only if the digits are tabular, and a live check of it.
// Texts are the Kit's own, not translated (rule `untranslated` exempts `kit/`).

import { Theme, Size, Type, TypeStep, Label, InkTone } from "../index.slint";
import { KitSection, KitRow, KitCaption } from "kit-parts.slint";

struct KitSizeRow { name: string, size: string, share: string, files: string }

global KitTextData {
    // A drive as the tree shows it; the figures add up. Many «1»s, so proportional digits show at once.
    out property <[KitSizeRow]> rows: [
        { name: "Users", size: "310.4 GB", share: "53.4 %", files: "3,789,066" },
        { name: "Games", size: "211.7 GB", share: "36.4 %", files: "88,114" },
        { name: "Windows", size: "41.1 GB", share: "7.1 %", files: "411,507" },
        { name: "Program Files", size: "18.1 GB", share: "3.1 %", files: "121,880" },
    ];
    out property <KitSizeRow> total: { name: "C:", size: "581.3 GB", share: "100.0 %", files: "4,410,567" };
    out property <[string]> figures: ["1,111.1 GB", "8,888.8 GB", "310.4 GB", "46.4 %", "3,789,066", "0 bytes"];
    out property <string> sentence-en: "Move 3 items to the Recycle Bin · Allocated 12.7 GB · node_modules";
    out property <string> sentence-it: "Sposta 3 elementi nel Cestino · Allocato 12,7 GB · «Ultima modifica»";
    // Two runs of the narrowest and the widest digit: equal widths mean tabular figures.
    out property <string> narrow-digits: "1111111111";
    out property <string> wide-digits: "0000000000";
}

// Sizes right-aligned in a column, as in the tree's Size column: they line up only with tabular digits.
export component KitFigures inherits VerticalLayout {
    in property <TypeStep> step;

    alignment: start;
    for figure in KitTextData.figures: Label {
        text: figure;
        step: root.step;
        align: TextHorizontalAlignment.right;
        width: Size.bar-w * 2;
    }
}

// One row of the size table: the name on the left, the figures right-aligned in fixed columns.
component KitSizeLine inherits HorizontalLayout {
    in property <KitSizeRow> entry;
    in property <TypeStep> name-step;
    in property <TypeStep> figure-step;

    spacing: Size.space-12;

    Label {
        text: root.entry.name;
        step: root.name-step;
        width: Size.bar-w * 2;
    }

    Label {
        text: root.entry.size;
        step: root.figure-step;
        align: TextHorizontalAlignment.right;
        width: Size.bar-w * 1.5;
    }

    Label {
        text: root.entry.share;
        step: root.figure-step;
        align: TextHorizontalAlignment.right;
        width: Size.bar-w;
    }

    Label {
        text: root.entry.files;
        step: root.figure-step;
        align: TextHorizontalAlignment.right;
        width: Size.bar-w * 1.5;
    }
}

// A small tree table whose total row is strong: its figures must line up with the rows above (decision 8).
component KitSizeTable inherits VerticalLayout {

    for row in KitTextData.rows: KitSizeLine {
        entry: row;
        name-step: TypeStep.body;
        figure-step: TypeStep.body;
    }
    Rectangle {
        height: Size.border-hairline;
        background: Theme.line;
    }

    KitSizeLine {
        entry: KitTextData.total;
        name-step: TypeStep.body-strong;
        figure-step: TypeStep.body-strong;
    }
}

// One type step: the two sentences, the figures in a right-aligned column, and whether its digits are tabular.
component KitTextStep inherits HorizontalLayout {
    in property <string> name;
    in property <TypeStep> step;
    out property <bool> tabular: narrow.preferred-width == wide.preferred-width;

    spacing: Size.space-16;
    alignment: start;

    KitCaption {
        text: root.name;
    }

    KitFigures {
        step: root.step;
    }

    VerticalLayout {
        alignment: start;
        spacing: Size.space-4;

        Label {
            text: KitTextData.sentence-en;
            step: root.step;
        }

        Label {
            text: KitTextData.sentence-it;
            step: root.step;
        }

        Label {
            text: KitTextData.wide-digits + " · " + KitTextData.narrow-digits;
            step: root.step;
        }

        Label {
            text: root.tabular ? "digits tabular" : "digits proportional: columns will not line up";
            step: TypeStep.caption;
            tone: root.tabular ? InkTone.success : InkTone.danger;
        }
    }

    // Measured only, never drawn: a zero-width cell keeps the probes out of the row's size.
    Rectangle {
        width: 0;
        visible: false;

        narrow := Label {
            text: KitTextData.narrow-digits;
            step: root.step;
        }

        wide := Label {
            text: KitTextData.wide-digits;
            step: root.step;
        }
    }
}

export component KitText inherits KitSection {
    // Whether the 12–13 px steps have tabular digits, regular and strong: the headless test reads them.
    out property <bool> regular-tabular: caption.tabular && body.tabular;
    out property <bool> strong-tabular: caption-strong.tabular && body-strong.tabular;

    title: "Text and digits · 12–13 px (test 7)";

    KitRow {
        name: "font";

        Label {
            text: Type.family;
            step: TypeStep.body-strong;
        }
    }

    KitRow {
        name: "tree total";

        KitSizeTable { }
    }

    caption := KitTextStep {
        name: "caption 12";
        step: TypeStep.caption;
    }

    caption-strong := KitTextStep {
        name: "caption-strong 12";
        step: TypeStep.caption-strong;
    }

    body := KitTextStep {
        name: "body 13";
        step: TypeStep.body;
    }

    body-strong := KitTextStep {
        name: "body-strong 13";
        step: TypeStep.body-strong;
    }
}

// The Kit's own layout pieces (§ 9): a section with its title, a row with its name, a pane with a frame. Kit only:
// screens never import them. Texts are the Kit's own, not translated (rule `untranslated` exempts `kit/`).

import { Theme, Size, TypeStep, Label, InkTone } from "../index.slint";

// The Kit's search (top bar): sections whose title does not match collapse. Slint has no substring or regular
// expression test, so Rust answers both (`src/kit.rs`).
export global KitSearch {
    in-out property <string> query;
    in-out property <bool> match-case;
    in-out property <bool> regex;
    pure callback matches(title: string, query: string, match-case: bool, regex: bool) -> bool;
    pure callback valid(query: string, regex: bool) -> bool;

    public pure function shows(title: string) -> bool {
        return query == "" || matches(title, query, match-case, regex);
    }
}

// A section: its title and its samples. A section the search hides takes no room at all (an invisible element
// would keep its place in the layout), and the gap after it goes with it.
export component KitSection {
    in property <string> title;

    property <bool> shown: KitSearch.shows(root.title);

    min-width: box.min-width;
    preferred-width: box.preferred-width;
    min-height: root.shown ? box.min-height : 0;
    preferred-height: root.shown ? box.preferred-height : 0;
    max-height: root.shown ? box.max-height : 0;

    box := VerticalLayout {
        width: root.width;
        height: root.height;
        visible: root.shown;
        spacing: Size.space-8;
        padding-bottom: Size.space-24;
        Label {
            text: root.title;
            step: TypeStep.overline;
            tone: InkTone.muted;
        }

        @children
    }
}

// The name of a row, in the Kit's quiet style, in a fixed column so the rows line up.
export component KitCaption inherits Label {
    step: TypeStep.caption;
    tone: InkTone.faint;
    width: Size.bar-w * 2;
}

// One row of a section: its name, then the samples.
export component KitRow inherits HorizontalLayout {
    in property <string> name;

    spacing: Size.space-16;
    alignment: start;
    KitCaption { text: root.name; }

    @children
}

// A text on a filled ground, for the `on-*` tones.
export component KitOnFill inherits Rectangle {
    in property <string> text;
    in property <InkTone> tone;

    HorizontalLayout {
        padding-left: Size.space-4;
        padding-right: Size.space-4;
        Label { text: root.text; tone: root.tone; }
    }
}

// A framed area with a small title, for the «Now» and «Proposal» of a review issue.
export component KitPane inherits Rectangle {
    in property <string> title;

    border-width: Size.border-hairline;
    border-color: Theme.line;
    border-radius: Size.radius-panel;

    VerticalLayout {
        padding: Size.card-pad;
        spacing: Size.space-8;
        alignment: start;
        Label { text: root.title; step: TypeStep.overline; tone: InkTone.faint; }

        @children
    }
}

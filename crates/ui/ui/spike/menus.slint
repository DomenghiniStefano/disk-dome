// Spike of card 4.T8 (`docs/design-system.md` § 5.16, § 5.17, § 12 test 8): Slint 1.19's `ContextMenuArea`,
// `Menu` and `Tooltip`, to see which of our tokens they take. Throwaway: removed once the owner decides.
// Exempt from the source rules like the other spikes, but it draws only with the design system's tokens.

import {
    Button,
    Icons,
    Label,
    Size,
    Theme,
    TypeStep,
} from "../design-system/index.slint";

// Where the three targets sit, so the headless test can point at them.
export global MenusSpikeLayout {
    out property <length> menu-x: 24px;
    out property <length> menu-y: 24px;
    out property <length> menu-w: 260px;
    out property <length> menu-h: 120px;
    out property <length> text-tip-x: 320px;
    out property <length> custom-tip-x: 560px;
    out property <length> tip-y: 40px;
}

export component MenusSpike inherits Window {
    title: @tr("DiskDome: Slint menus and tooltips");
    background: Theme.bg;
    preferred-width: 900px;
    preferred-height: 560px;

    // 1. Slint's context menu: right click, or the Menu key.
    Rectangle {
        x: MenusSpikeLayout.menu-x;
        y: MenusSpikeLayout.menu-y;
        width: MenusSpikeLayout.menu-w;
        height: MenusSpikeLayout.menu-h;
        background: Theme.surface;
        border-color: Theme.line;
        border-width: Size.border-hairline;
        border-radius: Size.radius-panel;

        Label {
            text: @tr("Right-click here: Slint's menu");
            step: TypeStep.caption;
        }

        ContextMenuArea {
            Menu {
                MenuItem {
                    title: @tr("Open");
                    icon: Icons.folder-open;
                }

                MenuItem {
                    title: @tr("Copy path");
                    icon: Icons.copy;
                }

                MenuSeparator { }

                Menu {
                    title: @tr("Sort by");

                    MenuItem {
                        title: @tr("Size");
                        checkable: true;
                        checked: true;
                    }

                    MenuItem {
                        title: @tr("Name");
                        checkable: true;
                    }
                }

                MenuItem {
                    title: @tr("Move to Recycle Bin");
                    enabled: false;
                }
            }
        }
    }

    // 2. Slint's tooltip with a text: the style draws it.
    Rectangle {
        x: MenusSpikeLayout.text-tip-x;
        y: MenusSpikeLayout.tip-y;
        width: self.preferred-width;
        height: self.preferred-height;

        Button {
            text: @tr("Tooltip: text");
        }

        Tooltip {
            // The text is `styled-text`: a translated string goes through `@markdown`.
            text: @markdown("\{@tr("Slint draws this tooltip with its own style.")}");
        }
    }

    // 3. Slint's tooltip with our content: § 5.17 drawn with the tokens.
    Rectangle {
        x: MenusSpikeLayout.custom-tip-x;
        y: MenusSpikeLayout.tip-y;
        width: self.preferred-width;
        height: self.preferred-height;

        Button {
            text: @tr("Tooltip: our content");
        }

        Tooltip {
            Rectangle {
                max-width: Size.tooltip-max;
                background: Theme.raised;
                border-color: Theme.edge;
                border-width: Size.border-hairline;
                border-radius: Size.radius-panel;
                drop-shadow-color: Theme.shadow;
                drop-shadow-offset-y: Size.shadow-1-y;
                drop-shadow-blur: Size.shadow-1-blur;

                VerticalLayout {
                    padding-left: Size.tooltip-pad-x;
                    padding-right: Size.tooltip-pad-x;
                    padding-top: Size.tooltip-pad-y;
                    padding-bottom: Size.tooltip-pad-y;

                    Label {
                        text: @tr("Raised, edge, panel radius, caption: every value is a token.");
                        step: TypeStep.caption;
                        wrap: true;
                    }
                }
            }
        }
    }
}

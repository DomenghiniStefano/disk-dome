// Spike of card 4.T1 (`docs/design-system.md` § 5.27, § 12 test 1): DiskDome's own title bar with the drive tabs.
// Throwaway: removed once the test decides where the tabs go. Exempt from the source rules like the step-3 proof,
// but it draws only with the design system's tokens.

import { Size, Theme, ThemeMode, Type, TypeStep } from "../design-system/index.slint";

export struct SpikeTab {
    letter: string,
    label: string,
}

component Glyph inherits Path {
    width: Size.caption-glyph;
    height: Size.caption-glyph;
    viewbox-width: 10;
    viewbox-height: 10;
    stroke-width: Size.border-hairline;
    fill: transparent;
}

component CaptionButton inherits Rectangle {
    in property <string> glyph;
    in property <bool> close;
    // Set from Windows for the maximise button, whose pointer events Windows keeps (Snap Layouts).
    in property <bool> native-hover;
    in property <bool> native-pressed;
    in property <string> name;
    callback clicked;

    width: Size.caption-button-w;
    accessible-role: button;
    accessible-label: name;
    property <bool> hot: touch.has-hover || native-hover;
    property <bool> down: touch.pressed || native-pressed;
    background: close && hot ? Theme.caption-close : down ? Theme.control-pressed : hot ? Theme.control-hover : transparent;

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    Glyph {
        commands: root.glyph;
        stroke: close && hot ? Theme.on-caption-close : Theme.ink;
    }
}

component Tab inherits Rectangle {
    in property <string> letter;
    in property <string> label;
    in property <bool> active;
    callback clicked;

    background: active ? Theme.bg : touch.has-hover ? Theme.control-pressed : transparent;
    border-top-left-radius: Size.radius-button;
    border-top-right-radius: Size.radius-button;

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: Size.space-10;
        padding-right: Size.space-10;
        spacing: Size.label-gap;
        Text {
            text: root.letter;
            vertical-alignment: center;
            color: root.active ? Theme.ink : Theme.ink-muted;
            font-family: Type.family;
            font-size: Type.size(TypeStep.body-strong);
            font-weight: Type.weight(TypeStep.body-strong);
        }

        Text {
            text: root.label;
            vertical-alignment: center;
            color: root.active ? Theme.ink-muted : Theme.ink-faint;
            font-family: Type.family;
            font-size: Type.size(TypeStep.caption);
            font-weight: Type.weight(TypeStep.caption);
        }
    }
}

export component TitlebarSpike inherits Window {
    title: @tr("DiskDome — title bar test");
    preferred-width: Size.window-w;
    preferred-height: Size.window-h;
    min-width: Size.window-min-w;
    min-height: Size.window-min-h;
    background: Theme.bg;

    in property <[SpikeTab]> tabs;
    in-out property <int> active: 1;
    in property <bool> is-maximized;
    in property <bool> max-hovered;
    in property <bool> max-pressed;
    // Where the interface's own parts of the bar end and the caption buttons start, for the hit test.
    out property <length> bar-height: bar.height;
    out property <length> tabs-end: plus.x + plus.width;
    out property <length> captions-x: captions.x;
    out property <length> caption-w: Size.caption-button-w;

    callback minimize();
    callback toggle-maximize();
    callback close-window();
    callback regions-changed();

    changed width => {
        root.regions-changed();
    }
    changed tabs-end => {
        root.regions-changed();
    }
    changed captions-x => {
        root.regions-changed();
    }

    VerticalLayout {
        bar := Rectangle {
            height: Size.titlebar;
            background: Theme.frame;

            HorizontalLayout {
                padding-left: Size.space-8;
                spacing: Size.space-2;

                Rectangle {
                    width: Size.icon + Size.space-8;
                    Image {
                        source: @image-url("../assets/brand/favicon.svg");
                        width: Size.icon;
                        height: Size.icon;
                    }
                }

                for tab[i] in root.tabs: Tab {
                    letter: tab.letter;
                    label: tab.label;
                    active: i == root.active;
                    clicked => {
                        root.active = i;
                    }
                }

                plus := Rectangle {
                    width: Size.titlebar;
                    background: plus-touch.has-hover ? Theme.control-pressed : transparent;
                    plus-touch := TouchArea { }
                    Glyph {
                        commands: "M 5 1 L 5 9 M 1 5 L 9 5";
                        stroke: Theme.ink-muted;
                    }
                }

                // The drag area: everything not taken by tabs and buttons.
                Rectangle {
                    horizontal-stretch: 1;
                }

                captions := HorizontalLayout {
                    CaptionButton {
                        name: @tr("Minimize");
                        glyph: "M 0 5 L 10 5";
                        clicked => {
                            root.minimize();
                        }
                    }

                    CaptionButton {
                        name: root.is-maximized ? @tr("Restore") : @tr("Maximize");
                        glyph: root.is-maximized ? "M 2.5 0.5 L 9.5 0.5 L 9.5 7.5 M 0.5 2.5 L 7.5 2.5 L 7.5 9.5 L 0.5 9.5 Z" : "M 0.5 0.5 L 9.5 0.5 L 9.5 9.5 L 0.5 9.5 Z";
                        native-hover: root.max-hovered;
                        native-pressed: root.max-pressed;
                        clicked => {
                            root.toggle-maximize();
                        }
                    }

                    CaptionButton {
                        name: @tr("Close");
                        glyph: "M 0 0 L 10 10 M 10 0 L 0 10";
                        close: true;
                        clicked => {
                            root.close-window();
                        }
                    }
                }
            }
        }

        Rectangle {
            background: Theme.bg;
            VerticalLayout {
                padding: Size.space-16;
                spacing: Size.space-8;
                alignment: start;

                Text {
                    text: @tr("Title bar test: drag, double-click, snap, resize from every edge, Alt+Space, two monitors.");
                    color: Theme.ink;
                    font-family: Type.family;
                    font-size: Type.size(TypeStep.body);
                }

                theme-button := Rectangle {
                    width: Size.search-w;
                    height: Size.control;
                    background: theme-touch.has-hover ? Theme.control-hover : Theme.control;
                    border-radius: Size.radius-button;
                    theme-touch := TouchArea {
                        clicked => {
                            Theme.mode = Theme.dark ? ThemeMode.light : ThemeMode.dark;
                        }
                    }
                    Text {
                        text: Theme.dark ? @tr("Switch to the light theme") : @tr("Switch to the dark theme");
                        color: Theme.ink;
                        font-family: Type.family;
                        font-size: Type.size(TypeStep.body);
                    }
                }
            }
        }
    }
}

// The build entry with a development feature, `kit` or `spikes` (`build.rs`): the app, the Kit window
// (`docs/design-system.md` § 9) and the throwaway proofs. Never in a release build.

export * from "app.slint";

// The technical proof of step 3 (card 3c): a table over millions of fake rows.
export { ProofRow, ProofTableWindow, ProofListWindow } from "proof.slint";

// The title bar spike (card 4.T1): `diskdome --spike-titlebar`.
export { SpikeTab, TitlebarSpike } from "spike/titlebar.slint";
export { KitWindow } from "design-system/kit/kit.slint";
// The review board's issues, counted by Rust for the top bar.
export { KitReview, KitIssueStatus } from "design-system/kit/kit-review.slint";
// The search over the sections, answered by Rust.
export { KitSearch } from "design-system/kit/kit-parts.slint";

// The run-time switches, so the Kit's headless test can read what the keyboard changed.
export { Theme, Size, Type } from "design-system/index.slint";
export { Nav } from "design-system/nav.slint";
// The Menu's test window (`tests/menu_headless.rs`).
export {
    KitMenuHarness,
    KitMenuProbe,
} from "design-system/kit/kit-menu-harness.slint";
// The popups' placement, for its unit tests.
export {
    Viewport,
    Placement,
    PopupAnchor,
} from "design-system/primitives/placement.slint";

// The build entry with a development feature, `kit` or `spikes` (`build.rs`): the app, the Kit window
// (`docs/design-system.md` § 9) and the throwaway proofs. Never in a release build.

export * from "app.slint";

// The technical proof of step 3 (card 3c): a table over millions of fake rows.
export { ProofRow, ProofTableWindow, ProofListWindow } from "proof.slint";

// The title bar spike (card 4.T1): `diskdome --spike-titlebar`.
export { SpikeTab, TitlebarSpike } from "spike/titlebar.slint";
export { KitWindow } from "kit/kit.slint";
// The review board's issues, counted by Rust for the top bar.
export { KitReview, KitIssueStatus } from "kit/kit-review.slint";
// The search over the sections, answered by Rust.
export { KitSearch } from "kit/kit-parts.slint";

// The run-time switches, so the Kit's headless test can read what the keyboard changed; the colour tokens and the data
// colours, for the contrast test (`tests/design_contrast.rs`).
export { Theme, Size, Type } from "@dome-ui";
export {
    Data,
    FileCategory,
    DataShade,
    AgeBucket,
} from "@dome-ui";
export { InputMode } from "@dome-ui";
// The Menu's test window (`tests/menu_headless.rs`).
export {
    KitMenuHarness,
    KitMenuProbe,
} from "kit/kit-menu-harness.slint";
// The Button's test window (`tests/button_headless.rs`).
export { KitButtonHarness } from "kit/kit-button-harness.slint";
// The SegmentedControl's test window (`tests/segmented_headless.rs`).
export { KitSegmentedHarness } from "kit/kit-segmented-harness.slint";
// The SearchField's test window (`tests/search_headless.rs`).
export { KitSearchHarness } from "kit/kit-search-harness.slint";
// The TextField's test window (`tests/textfield_headless.rs`).
export { KitTextFieldHarness } from "kit/kit-textfield-harness.slint";
// The Tooltip's test window (`tests/tooltip_headless.rs`).
export { KitTooltipHarness } from "kit/kit-tooltip-harness.slint";
// The ScrollBar's test window (`tests/scroll_headless.rs`).
export { KitScrollHarness } from "kit/kit-scroll-harness.slint";
// The Label's test window (`tests/label_headless.rs`).
export { KitLabelHarness } from "kit/kit-label-harness.slint";
// The Icon's test window (`tests/icon_headless.rs`).
export { KitIconHarness } from "kit/kit-icon-harness.slint";
// The ToggleButton's test window (`tests/toggle_headless.rs`).
export { KitToggleHarness } from "kit/kit-toggle-harness.slint";
// The Checkbox, RadioGroup and Switch's test window (`tests/choice_headless.rs`).
export { KitChoiceHarness } from "kit/kit-choice-harness.slint";
// The popups' placement, for its unit tests.
export {
    Viewport,
    Placement,
    PopupAnchor,
} from "@dome-ui";

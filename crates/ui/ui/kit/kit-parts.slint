// The Kit's own layout pieces (§ 9): a section with its title, a row with its name, a pane with a frame. Kit only:
// screens never import them. Texts are the Kit's own, not translated (rule `untranslated` exempts `kit/`).

import {
    Theme,
    Size,
    TypeStep,
    Label,
    InkTone,
    LabelWrap,
    ScrollBar,
    ScrollBarArrows,
    ScrollBarTrackClick,
    ScrollBarVisibility,
} from "@dome-ui";

// The Kit's search (top bar): sections whose title does not match collapse. Slint has no substring or regular
// expression test, so Rust answers both (`src/kit.rs`).
export global KitSearch {
    in-out property <string> query;
    in-out property <bool> match-case;
    in-out property <bool> regex;
    pure callback matches(title: string, query: string, match-case: bool, regex: bool) -> bool;
    pure callback valid(query: string, regex: bool) -> bool;

    public pure function shows(title: string) -> bool {
        return query == "" || matches(title, query, match-case, regex);
    }
}

// A section: its title and its samples. A section the search hides takes no room at all (an invisible element
// would keep its place in the layout), and the gap after it goes with it.
export component KitSection {
    in property <string> title;

    property <bool> shown: KitSearch.shows(root.title);

    min-width: box.min-width;
    preferred-width: box.preferred-width;
    min-height: root.shown ? box.min-height : 0;
    preferred-height: root.shown ? box.preferred-height : 0;
    max-height: root.shown ? box.max-height : 0;

    box := VerticalLayout {
        width: root.width;
        height: root.height;
        visible: root.shown;
        spacing: Size.space-8;
        padding-bottom: Size.space-24;

        Label {
            text: root.title;
            step: TypeStep.overline;
            tone: InkTone.muted;
        }

        @children
    }
}

// The name of a row, in the Kit's quiet style, in a fixed column so the rows line up.
export component KitCaption inherits Label {
    step: TypeStep.caption;
    tone: InkTone.faint;
    width: Size.bar-w * 2;
}

// One row of a section: its name, then the samples.
export component KitRow inherits HorizontalLayout {
    in property <string> name;

    spacing: Size.space-16;
    alignment: start;

    KitCaption {
        text: root.name;
    }

    @children
}

// A text on a filled ground, for the `on-*` tones.
export component KitOnFill inherits Rectangle {
    in property <string> text;
    in property <InkTone> tone;

    HorizontalLayout {
        padding-left: Size.space-4;
        padding-right: Size.space-4;

        Label {
            text: root.text;
            tone: root.tone;
        }
    }
}

// A framed area with a small title, for the «Now» and «Proposal» of a review issue.
export component KitPane inherits Rectangle {
    in property <string> title;

    border-width: Size.border-hairline;
    border-color: Theme.line;
    border-radius: Size.radius-panel;

    VerticalLayout {
        padding: Size.card-pad;
        spacing: Size.space-8;
        alignment: start;

        Label {
            text: root.title;
            step: TypeStep.overline;
            tone: InkTone.faint;
        }

        @children
    }
}

// A pane whose content scrolls under a working ScrollBar with the given options (§ 5.24): numbered lines down a
// vertical bar, numbered cells along a horizontal one, each line led by the option it shows (`name`). Few enough
// `lines` to fit show a bar over content that fits.
export component KitScrollDemo inherits Rectangle {
    in property <Orientation> orientation: Orientation.vertical;
    in property <ScrollBarArrows> arrows: ScrollBarArrows.none;
    in property <ScrollBarTrackClick> track-click: ScrollBarTrackClick.page;
    in property <ScrollBarVisibility> visibility: ScrollBarVisibility.scroll;
    in property <color> track-color: Theme.scroll-track;
    in property <bool> enabled: true;
    in property <string> name;
    in property <int> lines: 40;

    property <bool> vertical: root.orientation == Orientation.vertical;

    width: Size.bar-w * 3;
    height: Size.control-lg * 4;
    background: Theme.surface;
    border-radius: Size.radius-panel;
    clip: true;

    flick := Flickable {
        width: parent.width;
        height: parent.height;
        interactive: root.enabled;
        content-height: root.vertical ? column.preferred-height : self.height;
        content-width: root.vertical ? self.width : row.preferred-width;

        column := VerticalLayout {
            padding: Size.space-8;
            alignment: start;

            for index in root.vertical ? root.lines : 0: Label {
                text: root.name + " · " + (index + 1);
                step: TypeStep.caption;
                tone: InkTone.muted;
            }
        }

        row := HorizontalLayout {
            padding: Size.space-8;
            spacing: Size.space-16;
            alignment: start;

            for index in root.vertical ? 0 : root.lines: Label {
                text: root.name + " · " + (index + 1);
                step: TypeStep.caption;
                tone: InkTone.muted;
            }
        }
    }

    if root.vertical: ScrollBar {
        x: root.width - self.width;
        height: root.height;
        value <=> flick.content-y;
        content-length: flick.content-height;
        visible-length: flick.height;
        arrows: root.arrows;
        track-click: root.track-click;
        visibility: root.visibility;
        track-color: root.track-color;
        enabled: root.enabled;
    }

    if !root.vertical: ScrollBar {
        orientation: Orientation.horizontal;
        y: root.height - self.height;
        width: root.width;
        value <=> flick.content-x;
        content-length: flick.content-width;
        visible-length: flick.width;
        arrows: root.arrows;
        track-click: root.track-click;
        visibility: root.visibility;
        track-color: root.track-color;
        enabled: root.enabled;
    }
}

// A label held in a narrow framed box (§ 5.1, § 3.3), and beside it «cut» when the label says it is. The word only
// fades in and out: a text that changed with `cut` would change the layout that `cut` is computed from.
export component KitTextBox inherits HorizontalLayout {
    in property <string> text;
    in property <LabelWrap> wrap: LabelWrap.none;
    in property <int> max-lines: 0;

    spacing: Size.space-8;
    alignment: start;

    Rectangle {
        width: Size.bar-w * 3;
        border-width: Size.border-hairline;
        border-color: Theme.line;
        border-radius: Size.radius-control;

        HorizontalLayout {
            padding: Size.space-4;

            sample := Label {
                text: root.text;
                wrap: root.wrap;
                max-lines: root.max-lines;
            }
        }
    }

    KitCaption {
        text: "cut";
        opacity: sample.cut ? 1 : 0;
    }
}

// The Kit window (§ 9): every token and every component in every variant, size and state, side by side, with the
// real components, and the review board under the sections it concerns. Opened with
// `cargo run -p diskdome-ui --features kit -- --kit`.
//
// Texts here are the Kit's own, in English and not translated (rule `untranslated` exempts `kit/`).

import {
    Theme,
    ThemeMode,
    Size,
    Type,
    TypeStep,
    Icons,
    Label,
    SelectableLabel,
    LabelWrap,
    Icon,
    Button,
    SegmentedControl,
    SegmentedItem,
    SegmentedWidth,
    InkTone,
    IconSize,
    ButtonVariant,
    ButtonSize,
    ButtonWidth,
    SegmentedSize,
    KitState,
    ToggleButton,
    ToggleSize,
    ToggleVariant,
    SearchField,
    SearchFieldToggles,
    ScrollBar,
    ScrollBarArrows,
    ScrollBarTrackClick,
    ScrollBarVisibility,
    DomeWindow,
    MenuFrame,
    MenuList,
    MenuEntry,
    MenuNav,
    Menu,
    ContextMenu,
    MenuButton,
    TooltipBubble,
    MenuEntryKind,
    MenuItemVariant,
    PopupAlign,
    FileCategory,
} from "@dome-ui";
import {
    KitSection,
    KitRow,
    KitOnFill,
    KitTextBox,
    KitPane,
    KitScrollDemo,
    KitSearch,
} from "kit-parts.slint";
import { KitTokens } from "kit-tokens.slint";
import { KitText } from "kit-text.slint";
import { KitTextBitsSection } from "kit-text-bits-section.slint";
import { KitReview, KitIssue, KitReviewCount } from "kit-review.slint";

struct KitIcon { name: string, source: image }
struct KitStep { name: string, step: TypeStep }
struct KitTone { name: string, tone: InkTone }
struct KitFileIcon { name: string, source: image, category: FileCategory }
struct KitVariant { name: string, variant: ButtonVariant }
struct KitButtonSize { name: string, size: ButtonSize }
struct KitStateItem { name: string, state: KitState, enabled: bool }

// What the sections iterate: one place, so a new variant or state is one line here.
global KitData {
    out property <[KitStateItem]> states: [
        { name: "rest", state: KitState.live, enabled: true },
        { name: "hover", state: KitState.hover, enabled: true },
        { name: "pressed", state: KitState.pressed, enabled: true },
        { name: "focus", state: KitState.focus, enabled: true },
        { name: "disabled", state: KitState.live, enabled: false },
    ];
    out property <[KitStep]> steps: [
        { name: "display", step: TypeStep.display },
        { name: "title", step: TypeStep.title },
        { name: "body", step: TypeStep.body },
        { name: "body-strong", step: TypeStep.body-strong },
        { name: "caption", step: TypeStep.caption },
        { name: "caption-strong", step: TypeStep.caption-strong },
        { name: "overline", step: TypeStep.overline },
        { name: "mono", step: TypeStep.mono },
        { name: "map-name", step: TypeStep.map-name },
        { name: "map-name-xs", step: TypeStep.map-name-xs },
    ];
    // A file's icon in its category's colour (§ 3.12), one per category.
    out property <[KitFileIcon]> file-icons: [
        { name: "video", source: Icons.file-video, category: FileCategory.video },
        { name: "image", source: Icons.file-image, category: FileCategory.image },
        { name: "audio", source: Icons.file-audio, category: FileCategory.audio },
        { name: "document", source: Icons.file-text, category: FileCategory.document },
        { name: "game", source: Icons.gamepad-2, category: FileCategory.game },
        { name: "app", source: Icons.app-window, category: FileCategory.app },
        { name: "data", source: Icons.database, category: FileCategory.data },
        { name: "code", source: Icons.file-code, category: FileCategory.code },
        { name: "build", source: Icons.package, category: FileCategory.build },
        { name: "archive", source: Icons.file-archive, category: FileCategory.archive },
        { name: "system", source: Icons.cpu, category: FileCategory.system },
        { name: "other", source: Icons.file-question, category: FileCategory.other },
    ];
    out property <[KitTone]> tones: [
        { name: "normal", tone: InkTone.normal },
        { name: "muted", tone: InkTone.muted },
        { name: "faint", tone: InkTone.faint },
        { name: "accent", tone: InkTone.accent },
        { name: "danger", tone: InkTone.danger },
        { name: "warning", tone: InkTone.warning },
        { name: "success", tone: InkTone.success },
    ];
    out property <[KitVariant]> variants: [
        { name: "primary", variant: ButtonVariant.primary },
        { name: "secondary", variant: ButtonVariant.secondary },
        { name: "ghost", variant: ButtonVariant.ghost },
        { name: "danger", variant: ButtonVariant.danger },
        { name: "danger-ghost", variant: ButtonVariant.danger-ghost },
    ];
    out property <[KitButtonSize]> button-sizes: [
        { name: "small", size: ButtonSize.small },
        { name: "normal", size: ButtonSize.normal },
        { name: "large", size: ButtonSize.large },
        { name: "hero", size: ButtonSize.hero },
    ];
    // Every icon of `Icons` (checked by `tests/design_icons.rs`).
    out property <[KitIcon]> icons: [
        { name: "app-window", source: Icons.app-window },
        { name: "arrow-down", source: Icons.arrow-down },
        { name: "arrow-up", source: Icons.arrow-up },
        { name: "bookmark", source: Icons.bookmark },
        { name: "braces", source: Icons.braces },
        { name: "bug", source: Icons.bug },
        { name: "case-sensitive", source: Icons.case-sensitive },
        { name: "check", source: Icons.check },
        { name: "chevron-down", source: Icons.chevron-down },
        { name: "chevron-right", source: Icons.chevron-right },
        { name: "circle-alert", source: Icons.circle-alert },
        { name: "circle-help", source: Icons.circle-help },
        { name: "clipboard-list", source: Icons.clipboard-list },
        { name: "command", source: Icons.command },
        { name: "copy", source: Icons.copy },
        { name: "corner-left-up", source: Icons.corner-left-up },
        { name: "cpu", source: Icons.cpu },
        { name: "database", source: Icons.database },
        { name: "ellipsis", source: Icons.ellipsis },
        { name: "external-link", source: Icons.external-link },
        { name: "file", source: Icons.file },
        { name: "file-archive", source: Icons.file-archive },
        { name: "file-audio", source: Icons.file-audio },
        { name: "file-code", source: Icons.file-code },
        { name: "file-image", source: Icons.file-image },
        { name: "file-question", source: Icons.file-question },
        { name: "file-text", source: Icons.file-text },
        { name: "file-video", source: Icons.file-video },
        { name: "filter", source: Icons.filter },
        { name: "folder", source: Icons.folder },
        { name: "folder-input", source: Icons.folder-input },
        { name: "folder-open", source: Icons.folder-open },
        { name: "folder-search", source: Icons.folder-search },
        { name: "gamepad-2", source: Icons.gamepad-2 },
        { name: "hard-drive", source: Icons.hard-drive },
        { name: "history", source: Icons.history },
        { name: "house", source: Icons.house },
        { name: "image", source: Icons.image },
        { name: "info", source: Icons.info },
        { name: "keyboard", source: Icons.keyboard },
        { name: "layers", source: Icons.layers },
        { name: "layout-dashboard", source: Icons.layout-dashboard },
        { name: "link", source: Icons.link },
        { name: "monitor", source: Icons.monitor },
        { name: "moon", source: Icons.moon },
        { name: "package", source: Icons.package },
        { name: "panel-right", source: Icons.panel-right },
        { name: "pencil", source: Icons.pencil },
        { name: "play", source: Icons.play },
        { name: "recycle", source: Icons.recycle },
        { name: "refresh-cw", source: Icons.refresh-cw },
        { name: "regex", source: Icons.regex },
        { name: "search", source: Icons.search },
        { name: "settings", source: Icons.settings },
        { name: "share", source: Icons.share },
        { name: "sheet", source: Icons.sheet },
        { name: "shield-alert", source: Icons.shield-alert },
        { name: "square", source: Icons.square },
        { name: "sun", source: Icons.sun },
        { name: "terminal", source: Icons.terminal },
        { name: "trash-2", source: Icons.trash-2 },
        { name: "triangle-alert", source: Icons.triangle-alert },
        { name: "x", source: Icons.x },
    ];
    out property <[SegmentedItem]> two-options: [{ text: "Extensions" }, { text: "Categories" }];
    out property <[ToggleSize]> toggle-sizes: [ToggleSize.small, ToggleSize.normal, ToggleSize.large];
    out property <[ToggleVariant]> toggle-variants: [ToggleVariant.ghost, ToggleVariant.outline];
    // The scroll bar at rest is hidden: `live` shows nothing until the content moves.
    out property <[KitState]> scroll-states: [KitState.live, KitState.focus, KitState.hover, KitState.pressed];
    out property <[SegmentedItem]> three-options: [{ text: "Dark" }, { text: "Light" }, { text: "System" }];
    // Italian labels, longer than the English ones (§ 3.3): in a narrow box they are cut.
    out property <[SegmentedItem]> long-options: [{ text: "Estensioni per dimensione" }, { text: "Categorie per tipo" }];
    out property <[SegmentedItem]> theme-icons: [
        { text: "Dark", icon: Icons.moon },
        { text: "Light", icon: Icons.sun },
        { text: "System", icon: Icons.monitor },
    ];
    out property <[SegmentedItem]> theme-icons-only: [
        { text: "Dark", icon: Icons.moon, icon-only: true },
        { text: "Light", icon: Icons.sun, icon-only: true },
        { text: "System", icon: Icons.monitor, icon-only: true },
    ];
    // A segment that cannot be chosen yet says why.
    out property <[SegmentedItem]> with-disabled: [
        { text: "Table" },
        { text: "Both" },
        { text: "Map", disabled: true, tooltip: "The map needs a finished scan" },
    ];
    // An Italian label, ~25 % longer than English (§ 3.3): buttons must grow with it.
    out property <string> long-label: "Sposta nel Cestino";
    out property <string> sample-text: "Users 310.4 GB · 46.4 % · 3,789,066 files";
    // Longer than the Kit's narrow boxes, with spaces and without (§ 3.3).
    out property <string> long-text: "Every file of the drive, the largest first, with its folder and when it changed";
    out property <string> long-path: "C:\\Users\\someone\\AppData\\Local\\Temp\\cache\\thumbnails";
    // Every kind of entry, variant and state of § 5.16, with repeated and trailing separators that must not show.
    in-out property <[MenuEntry]> menu: [
        { id: "open", label: "Open", icon: Icons.folder-open, shortcut: "Enter" },
        {
            id: "explorer",
            label: "Show in File Explorer",
            icon: Icons.external-link,
            shortcut: "Ctrl+E"
        },
        { kind: MenuEntryKind.separator },
        { kind: MenuEntryKind.section, label: "Sort by" },
        { id: "size", kind: MenuEntryKind.radio, label: "Size", checked: true },
        { id: "name", kind: MenuEntryKind.radio, label: "Name" },
        { kind: MenuEntryKind.separator },
        { kind: MenuEntryKind.separator },
        { id: "free", kind: MenuEntryKind.checkbox, label: "Free space", checked: true },
        { id: "names", kind: MenuEntryKind.checkbox, label: "Names" },
        { id: "columns", label: "Columns", icon: Icons.layout-dashboard, submenu: true },
        {
            id: "rename",
            label: "Rename",
            icon: Icons.pencil,
            shortcut: "F2",
            disabled: true,
            reason: "Select one item to rename it"
        },
        { kind: MenuEntryKind.separator },
        { id: "recycle", label: "Move to the Recycle Bin", icon: Icons.trash-2, shortcut: "Del" },
        {
            id: "delete",
            label: "Delete permanently",
            icon: Icons.trash-2,
            shortcut: "Shift+Del",
            variant: MenuItemVariant.danger
        },
        { kind: MenuEntryKind.separator },
    ];
    in-out property <[MenuEntry]> menu-columns: [
        {
            id: "col-name",
            kind: MenuEntryKind.checkbox,
            label: "Name",
            checked: true,
            disabled: true,
            reason: "The name is always shown"
        },
        { id: "col-size", kind: MenuEntryKind.checkbox, label: "Size", checked: true },
        { id: "col-allocated", kind: MenuEntryKind.checkbox, label: "Allocated", checked: true },
        { id: "col-modified", kind: MenuEntryKind.checkbox, label: "Modified" },
        { kind: MenuEntryKind.separator },
        { id: "col-more", label: "More columns", submenu: true },
    ];
    in-out property <[MenuEntry]> menu-more: [
        { id: "col-created", kind: MenuEntryKind.checkbox, label: "Created" },
        { id: "col-attributes", kind: MenuEntryKind.checkbox, label: "Attributes" },
    ];
    // Overflow: a label longer than `menu-max`, a hint, and a list taller than its box.
    out property <[MenuEntry]> menu-long: [
        {
            id: "long",
            label: "A label much longer than the widest menu, cut at the end with an ellipsis",
            icon: Icons.file
        },
        {
            id: "hint",
            label: "Downloads",
            hint: "C:\\Users\\Anna\\Downloads · 12.4 GB",
            icon: Icons.folder
        },
        { id: "a", label: "Alpha" },
        { id: "b", label: "Bravo" },
        { id: "c", label: "Charlie" },
        { id: "d", label: "Delta" },
        { id: "e", label: "Echo" },
        { id: "f", label: "Foxtrot" },
        { id: "g", label: "Golf" },
        { id: "h", label: "Hotel" },
    ];
    out property <[MenuEntry]> no-entries: [];

    // The last item chosen in any Kit menu, shown next to them.
    in-out property <string> chosen: "nothing yet";

    // Every Kit menu works: a choice flips its check box or radio item, wherever that entry lives.
    public function choose(entry: MenuEntry) {
        root.menu = MenuNav.toggled(root.menu, entry.id);
        root.menu-columns = MenuNav.toggled(root.menu-columns, entry.id);
        root.menu-more = MenuNav.toggled(root.menu-more, entry.id);
        root.chosen = entry.label;
    }

    public pure function submenu(entry: MenuEntry) -> [MenuEntry] {
        return entry.id == "columns" ? menu-columns : entry.id == "col-more" ? menu-more : no-entries;
    }
}

// Every icon, in rows of `columns` (Slint 1.19 layouts do not wrap).
component KitIconGrid {
    property <int> columns: 21;
    property <length> pitch: Size.control-sm;

    width: self.columns * self.pitch;
    height: Math.ceil(KitData.icons.length / self.columns) * self.pitch;

    for item[index] in KitData.icons: Icon {
        x: Math.mod(index, root.columns) * root.pitch;
        y: Math.floor(index / root.columns) * root.pitch;
        source: item.source;
        label: item.name;
    }
}

export component KitWindow inherits DomeWindow {
    title: "DiskDome Kit";
    preferred-width: Size.window-w;
    preferred-height: Size.window-h;
    min-width: Size.window-min-w;
    min-height: Size.window-min-h;

    // Read by the headless test (test 7).
    out property <bool> regular-tabular: text.regular-tabular;
    out property <bool> strong-tabular: text.strong-tabular;

    VerticalLayout {
        // The run-time switches of § 3.1.
        Rectangle {
            height: Size.toolbar;
            background: Theme.surface;

            HorizontalLayout {
                padding-left: Size.panel-pad;
                padding-right: Size.panel-pad;
                spacing: Size.group-gap;
                alignment: start;

                VerticalLayout {
                    alignment: center;

                    Label {
                        text: "DiskDome Kit";
                        step: TypeStep.body-strong;
                    }
                }

                VerticalLayout {
                    alignment: center;

                    SegmentedControl {
                        items: [{ text: "Dark" }, { text: "Light" }];
                        current-index: Theme.mode == ThemeMode.dark ? 0 : 1;
                        selected(index) => {
                            Theme.mode = index == 0 ? ThemeMode.dark : ThemeMode.light;
                        }
                        accessible-label: "Theme";
                    }
                }

                VerticalLayout {
                    alignment: center;

                    SegmentedControl {
                        items: [{ text: "Normal" }, { text: "Compact" }];
                        current-index: Size.compact ? 1 : 0;
                        selected(index) => {
                            Size.compact = index == 1;
                        }
                        accessible-label: "Density";
                    }
                }

                VerticalLayout {
                    alignment: center;

                    KitReviewCount { }
                }

                // The Kit's search over the sections' titles.
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;

                    SearchField {
                        placeholder: "Search sections";
                        text <=> KitSearch.query;
                        match-case <=> KitSearch.match-case;
                        regex <=> KitSearch.regex;
                        error: KitSearch.valid(KitSearch.query, KitSearch.regex) ? "" : "Not a valid regular expression";
                        search-requested => {
                            flick.content-y = 0;
                        }
                    }
                }
            }
        }

        Rectangle {
            flick := Flickable {
                width: parent.width;
                height: parent.height;
                content-height: sections.preferred-height;

                sections := VerticalLayout {
                    padding: Size.space-16;
                    alignment: start;

                    text := KitText { }

                    KitTokens { }

                    KitSection {
                        title: "Review · title bar";

                        KitIssue {
                            issue: KitReview.issues[2];

                            KitPane {
                                title: "Proposal";

                                HorizontalLayout {
                                    Rectangle {
                                        width: Size.caption-button-w * 3;
                                        height: Size.titlebar;
                                        background: Theme.frame;
                                    }

                                    Rectangle {
                                        width: Size.caption-button-w;
                                        height: Size.titlebar;
                                        background: Theme.caption-close;
                                    }
                                }
                            }
                        }
                    }

                    KitSection {
                        title: "Label · steps";
                        for item in KitData.steps: KitRow {
                            name: item.name;

                            Label {
                                text: KitData.sample-text;
                                step: item.step;
                            }
                        }
                    }

                    KitSection {
                        title: "Label · tones";

                        KitRow {
                            name: "tones";
                            for item in KitData.tones: Label {
                                text: item.name;
                                tone: item.tone;
                            }
                            KitOnFill {
                                text: "on-accent";
                                tone: InkTone.on-accent;
                                background: Theme.accent;
                            }

                            KitOnFill {
                                text: "on-danger";
                                tone: InkTone.on-danger;
                                background: Theme.danger;
                            }
                        }
                    }

                    KitSection {
                        title: "Label · wrap and cut";

                        KitRow {
                            name: "one line";

                            KitTextBox {
                                text: "Size";
                            }

                            KitTextBox {
                                text: KitData.long-text;
                            }
                        }

                        KitRow {
                            name: "word, anywhere";

                            KitTextBox {
                                text: KitData.long-text;
                                wrap: LabelWrap.word;
                            }

                            KitTextBox {
                                text: KitData.long-path;
                                wrap: LabelWrap.anywhere;
                            }
                        }

                        KitRow {
                            name: "max-lines 2";

                            KitTextBox {
                                text: KitData.long-text;
                                wrap: LabelWrap.word;
                                max-lines: 2;
                            }

                            KitTextBox {
                                text: KitData.long-path;
                                wrap: LabelWrap.anywhere;
                                max-lines: 2;
                            }
                        }
                    }

                    KitSection {
                        title: "Label · selectable";

                        KitRow {
                            name: "drag, Ctrl+A, Ctrl+C";

                            VerticalLayout {
                                width: Size.bar-w * 3;
                                spacing: Size.space-8;

                                SelectableLabel {
                                    text: KitData.long-path;
                                    wrap: LabelWrap.anywhere;
                                }

                                SelectableLabel {
                                    text: KitData.long-text;
                                    wrap: LabelWrap.word;
                                }
                            }
                        }

                        KitRow {
                            name: "right-click";

                            ContextMenu {
                                width: Size.bar-w * 3;
                                height: Size.control-lg;
                                requested(x, y) => {
                                    copy-menu.open-at(x, y);
                                }

                                // The area holds its content centred at its preferred size: a layout lines it up with the rows.
                                HorizontalLayout {
                                    alignment: start;
                                    width: Size.bar-w * 3;
                                    height: Size.control-lg;

                                    copyable := SelectableLabel {
                                        text: "Select a few words, then right-click";
                                    }
                                }

                                copy-menu := Menu {
                                    entries: [
                                        {
                                            id: "copy",
                                            label: "Copy",
                                            shortcut: "Ctrl+C",
                                            disabled: !copyable.has-selection,
                                            reason: "Select some text first",
                                        },
                                        { id: "select-all", label: "Select all", shortcut: "Ctrl+A" },
                                    ];
                                    activated(entry) => {
                                        if (entry.id == "copy") {
                                            copyable.copy();
                                        } else {
                                            copyable.select-all();
                                        }
                                    }
                                }
                            }
                        }
                    }

                    KitSection {
                        title: "Icon";

                        KitRow {
                            name: "all";

                            KitIconGrid { }
                        }

                        KitRow {
                            name: "sizes";

                            Icon {
                                source: Icons.folder;
                                size: IconSize.small;
                            }

                            Icon {
                                source: Icons.folder;
                                size: IconSize.normal;
                            }

                            Icon {
                                source: Icons.folder;
                                size: IconSize.hero;
                            }
                        }

                        KitRow {
                            name: "tones";
                            for item in KitData.tones: Icon {
                                source: Icons.hard-drive;
                                tone: item.tone;
                            }
                        }

                        KitRow {
                            name: "data: categories";
                            for item in KitData.file-icons: Icon {
                                source: item.source;
                                tone: InkTone.data;
                                category: item.category;
                                label: item.name;
                            }
                        }

                        KitRow {
                            name: "side: 24, 32, 48";

                            Icon {
                                source: Icons.folder;
                                side: Size.space-24;
                            }

                            Icon {
                                source: Icons.folder;
                                side: Size.space-32;
                            }

                            Icon {
                                source: Icons.folder;
                                side: Size.space-48;
                            }
                        }
                    }

                    KitSection {
                        title: "Button · variants × states";
                        for row in KitData.variants: KitRow {
                            name: row.name;
                            for state in KitData.states: Button {
                                text: state.name;
                                variant: row.variant;
                                kit-state: state.state;
                                enabled: state.enabled;
                            }
                        }
                    }

                    KitSection {
                        title: "Button · content and sizes";
                        for row in KitData.variants: KitRow {
                            name: row.name;

                            Button {
                                text: "Scan";
                                icon: Icons.play;
                                variant: row.variant;
                            }

                            Button {
                                icon: Icons.refresh-cw;
                                variant: row.variant;
                                accessible-label: "Rescan";
                            }

                            Button {
                                text: KitData.long-label;
                                variant: row.variant;
                            }

                            for size in KitData.button-sizes: Button {
                                text: size.name;
                                variant: row.variant;
                                size: size.size;
                            }
                        }
                        KitRow {
                            name: "hero";

                            Button {
                                text: "Scan C:";
                                icon: Icons.hard-drive;
                                variant: ButtonVariant.primary;
                                size: ButtonSize.hero;
                            }
                        }

                        KitIssue {
                            issue: KitReview.issues[0];

                            KitPane {
                                title: "Proposal";

                                HorizontalLayout {
                                    spacing: Size.space-8;
                                    for state in KitData.states: Button {
                                        text: state.name;
                                        variant: ButtonVariant.danger;
                                        kit-state: state.state;
                                        enabled: state.enabled;
                                    }
                                }
                            }
                        }
                    }

                    KitSection {
                        title: "Button · width and overflow";

                        KitRow {
                            name: "minimum, long label";

                            Button {
                                text: "OK";
                            }

                            Button {
                                text: KitData.long-label;
                            }
                        }

                        KitRow {
                            name: "narrow box";

                            HorizontalLayout {
                                alignment: start;
                                width: Size.button-min-w * 2;

                                Button {
                                    text: "Move everything to the Recycle Bin";
                                }
                            }
                        }

                        KitRow {
                            name: "full width";

                            VerticalLayout {
                                width: Size.side-panel;

                                Button {
                                    text: "Continue";
                                    variant: ButtonVariant.primary;
                                    width-mode: ButtonWidth.fill;
                                }
                            }
                        }

                        KitRow {
                            name: "trailing icon";

                            Button {
                                text: "Columns";
                                icon-end: Icons.chevron-down;
                            }

                            Button {
                                text: "Sort";
                                icon: Icons.arrow-down;
                                icon-end: Icons.chevron-down;
                                variant: ButtonVariant.ghost;
                            }

                            Button {
                                text: "Export";
                                icon-end: Icons.chevron-down;
                                size: ButtonSize.small;
                            }
                        }
                    }

                    KitSection {
                        title: "SegmentedControl · sizes × states";
                        for state in KitData.states: KitRow {
                            name: state.name;

                            SegmentedControl {
                                items: KitData.two-options;
                                size: SegmentedSize.small;
                                kit-state: state.state;
                                enabled: state.enabled;
                                accessible-label: "Side panel list";
                            }

                            SegmentedControl {
                                items: KitData.three-options;
                                kit-state: state.state;
                                enabled: state.enabled;
                                accessible-label: "Theme";
                            }
                        }
                        KitIssue {
                            issue: KitReview.issues[1];

                            KitPane {
                                title: "Proposal";

                                SegmentedControl {
                                    items: KitData.three-options;
                                    accessible-label: "Theme";
                                }
                            }
                        }
                    }

                    KitSection {
                        title: "SegmentedControl · content";

                        KitRow {
                            name: "icon and text";

                            SegmentedControl {
                                items: KitData.theme-icons;
                                accessible-label: "Theme";
                            }

                            SegmentedControl {
                                items: KitData.theme-icons;
                                size: SegmentedSize.small;
                                accessible-label: "Theme";
                            }
                        }

                        KitRow {
                            name: "icon only";

                            SegmentedControl {
                                items: KitData.theme-icons-only;
                                accessible-label: "Theme";
                            }

                            SegmentedControl {
                                items: KitData.theme-icons-only;
                                size: SegmentedSize.small;
                                accessible-label: "Theme";
                            }
                        }

                        KitRow {
                            name: "disabled segment";

                            SegmentedControl {
                                items: KitData.with-disabled;
                                accessible-label: "View";
                            }
                        }

                        KitRow {
                            name: "nothing chosen";

                            SegmentedControl {
                                items: KitData.three-options;
                                current-index: -1;
                                accessible-label: "Theme";
                            }
                        }
                    }

                    KitSection {
                        title: "SegmentedControl · width and overflow";

                        KitRow {
                            name: "narrow box";

                            HorizontalLayout {
                                alignment: start;
                                width: Size.segment-min-w * 3;

                                SegmentedControl {
                                    items: KitData.long-options;
                                    accessible-label: "Side panel list";
                                }
                            }
                        }

                        KitRow {
                            name: "hug, fill";

                            VerticalLayout {
                                width: Size.side-panel;
                                spacing: Size.group-gap;

                                SegmentedControl {
                                    items: KitData.two-options;
                                    accessible-label: "Side panel list";
                                }

                                SegmentedControl {
                                    items: KitData.two-options;
                                    width-mode: SegmentedWidth.fill;
                                    accessible-label: "Side panel list";
                                }

                                SegmentedControl {
                                    items: KitData.theme-icons;
                                    width-mode: SegmentedWidth.fill;
                                    size: SegmentedSize.small;
                                    accessible-label: "Theme";
                                }
                            }
                        }
                    }

                    KitSection {
                        title: "ToggleButton · sizes × states";
                        for state in KitData.states: KitRow {
                            name: state.name;
                            for size in KitData.toggle-sizes: ToggleButton {
                                icon: Icons.panel-right;
                                size: size;
                                kit-state: state.state;
                                enabled: state.enabled;
                                accessible-label: "Side panel";
                            }
                            for size in KitData.toggle-sizes: ToggleButton {
                                icon: Icons.panel-right;
                                size: size;
                                checked: true;
                                kit-state: state.state;
                                enabled: state.enabled;
                                accessible-label: "Side panel";
                            }
                            for variant in KitData.toggle-variants: ToggleButton {
                                text: "Panel";
                                icon: Icons.panel-right;
                                variant: variant;
                                kit-state: state.state;
                                enabled: state.enabled;
                            }
                            for variant in KitData.toggle-variants: ToggleButton {
                                text: "Panel";
                                icon: Icons.panel-right;
                                variant: variant;
                                checked: true;
                                kit-state: state.state;
                                enabled: state.enabled;
                            }
                        }
                    }

                    KitSection {
                        title: "ToggleButton · content and width";
                        for variant[index] in KitData.toggle-variants: KitRow {
                            name: index == 0 ? "ghost" : "outline";

                            ToggleButton {
                                text: "Filters";
                                variant: variant;
                            }

                            ToggleButton {
                                text: "Filters";
                                icon: Icons.filter;
                                variant: variant;
                                checked: true;
                            }

                            ToggleButton {
                                icon: Icons.case-sensitive;
                                variant: variant;
                                accessible-label: "Match case";
                            }

                            ToggleButton {
                                text: "Large";
                                size: ToggleSize.large;
                                variant: variant;
                            }

                            HorizontalLayout {
                                alignment: start;
                                width: Size.button-min-w;

                                ToggleButton {
                                    text: "Mostra i file nascosti";
                                    variant: variant;
                                }
                            }
                        }
                    }

                    KitSection {
                        title: "SearchField · states";

                        KitRow {
                            name: "empty";

                            SearchField {
                                placeholder: "Search names";
                            }
                        }

                        KitRow {
                            name: "text";

                            SearchField {
                                placeholder: "Search names";
                                text: "node_modules";
                            }
                        }

                        KitRow {
                            name: "case and regex";

                            SearchField {
                                placeholder: "Search names";
                                text: "^Cache.*\\.tmp$";
                                match-case: true;
                                regex: true;
                            }
                        }

                        KitRow {
                            name: "error";

                            SearchField {
                                placeholder: "Search names";
                                text: "([a-z";
                                regex: true;
                                error: "Not a valid regular expression: a bracket is not closed";
                            }
                        }

                        KitRow {
                            name: "focus";

                            SearchField {
                                placeholder: "Search names";
                                kit-state: KitState.focus;
                            }
                        }

                        KitRow {
                            name: "disabled";

                            SearchField {
                                placeholder: "Search names";
                                enabled: false;
                            }

                            SearchField {
                                placeholder: "Search names";
                                text: "node_modules";
                                enabled: false;
                            }
                        }

                        KitRow {
                            name: "toggles";

                            SearchField {
                                placeholder: "Type a command";
                                toggles: SearchFieldToggles.none;
                            }

                            SearchField {
                                placeholder: "Search an action or a key";
                                toggles: SearchFieldToggles.match-case;
                                text: "Ctrl";
                            }
                        }
                    }

                    KitSection {
                        title: "MenuList · entries and states";

                        KitRow {
                            name: "highlight, every kind";

                            MenuFrame {
                                animate-in: false;
                                height: self.preferred-height;

                                MenuList {
                                    entries: KitData.menu;
                                    highlighted-index: 1;
                                    activated(entry, index) => {
                                        KitData.choose(entry);
                                    }
                                }
                            }

                            MenuFrame {
                                animate-in: false;
                                height: self.preferred-height;

                                MenuList {
                                    entries: KitData.menu-columns;
                                    highlighted-index: 1;
                                    activated(entry, index) => {
                                        KitData.choose(entry);
                                    }
                                }
                            }
                        }

                        KitRow {
                            name: "overflow, scroll, empty";

                            MenuFrame {
                                animate-in: false;
                                height: Size.menu-item * 6;

                                MenuList {
                                    entries: KitData.menu-long;
                                    highlighted-index: 0;
                                    activated(entry, index) => {
                                        KitData.choose(entry);
                                    }
                                }
                            }

                            MenuFrame {
                                animate-in: false;
                                height: self.preferred-height;

                                MenuList {
                                    entries: KitData.no-entries;
                                    empty-text: "Nothing to show";
                                }
                            }
                        }
                    }

                    KitSection {
                        title: "Menu · MenuButton · ContextMenu";

                        KitRow {
                            name: "buttons";

                            MenuButton {
                                icon: Icons.ellipsis;
                                accessible-label: "More";
                                entries: KitData.menu;
                                activated(entry) => {
                                    KitData.choose(entry);
                                }
                                submenu(entry) => {
                                    return KitData.submenu(entry);
                                }
                            }

                            MenuButton {
                                text: "Columns";
                                variant: ButtonVariant.secondary;
                                entries: KitData.menu-columns;
                                activated(entry) => {
                                    KitData.choose(entry);
                                }
                                keep-open-on-check: true;
                                submenu(entry) => {
                                    return KitData.submenu(entry);
                                }
                            }

                            MenuButton {
                                text: "End-aligned";
                                variant: ButtonVariant.secondary;
                                align: PopupAlign.end;
                                entries: KitData.menu-long;
                                activated(entry) => {
                                    KitData.choose(entry);
                                }
                            }

                            MenuButton {
                                text: "Empty";
                                variant: ButtonVariant.secondary;
                                entries: KitData.no-entries;
                                activated(entry) => {
                                    KitData.choose(entry);
                                }
                                empty-text: "Nothing to show";
                            }

                            MenuButton {
                                text: "Disabled";
                                variant: ButtonVariant.secondary;
                                enabled: false;
                                entries: KitData.menu;
                                activated(entry) => {
                                    KitData.choose(entry);
                                }
                            }
                        }

                        KitRow {
                            name: "last chosen";

                            Label {
                                text: KitData.chosen;
                                tone: InkTone.muted;
                            }
                        }

                        KitRow {
                            name: "right-click";

                            ContextMenu {
                                width: Size.side-panel;
                                height: Size.control-lg * 3;
                                requested(x, y) => {
                                    area-menu.open-at(x, y);
                                }

                                Rectangle {
                                    background: Theme.surface;
                                    border-radius: Size.radius-panel;

                                    Label {
                                        text: "Right-click, Menu key or Shift+F10";
                                        tone: InkTone.muted;
                                    }
                                }

                                area-menu := Menu {
                                    entries: KitData.menu;
                                    activated(entry) => {
                                        KitData.choose(entry);
                                    }
                                    submenu(entry) => {
                                        return KitData.submenu(entry);
                                    }
                                }
                            }
                        }
                    }

                    KitSection {
                        title: "Tooltip · bubble and buttons";

                        KitRow {
                            name: "bubbles";

                            TooltipBubble {
                                animate-in: false;
                                height: self.preferred-height;
                                text: "Scan again";
                            }

                            TooltipBubble {
                                animate-in: false;
                                height: self.preferred-height;
                                text: "Export";
                                shortcut: "Ctrl+Shift+E";
                            }

                            TooltipBubble {
                                animate-in: false;
                                width: Size.tooltip-max;
                                height: self.preferred-height;
                                text: "A long tooltip wraps at the tooltip's maximum width and never grows wider than the window allows.";
                            }

                            TooltipBubble {
                                animate-in: false;
                                height: self.preferred-height;
                                text: "Free content under the text";

                                Label {
                                    text: "C:\\Users · 310.4 GB";
                                    step: TypeStep.caption;
                                    tone: InkTone.muted;
                                }
                            }
                        }

                        KitRow {
                            name: "hover or focus these";

                            Button {
                                icon: Icons.refresh-cw;
                                accessible-label: "Scan again";
                                tooltip-shortcut: "F5";
                            }

                            ToggleButton {
                                icon: Icons.panel-right;
                                accessible-label: "File types panel";
                            }

                            Button {
                                text: "Export";
                                tooltip: "Save the scan as CSV, JSON or an HTML report";
                                tooltip-shortcut: "Ctrl+Shift+E";
                            }

                            Button {
                                text: "Rename";
                                enabled: false;
                                tooltip: "Select one item to rename it";
                            }
                        }
                    }

                    // Badge, Kbd, KbdGroup, Chip and Breadcrumb (§ 5.13–5.15, § 5.26).
                    KitTextBitsSection { }

                    KitSection {
                        title: "ScrollBar · states";

                        KitRow {
                            name: "rest, shown, hover, drag";
                            for state in KitData.scroll-states: Rectangle {
                                width: Size.bar-w * 2;
                                height: Size.control-lg * 3;
                                background: Theme.surface;
                                border-radius: Size.radius-panel;

                                ScrollBar {
                                    x: parent.width - self.width;
                                    height: parent.height;
                                    value: -Size.control-lg * 3;
                                    content-length: Size.control-lg * 12;
                                    visible-length: Size.control-lg * 3;
                                    kit-state: state;
                                }
                            }
                        }
                    }

                    KitSection {
                        title: "ScrollBar · options";

                        KitRow {
                            name: "arrows";

                            KitScrollDemo {
                                name: "none";
                                visibility: ScrollBarVisibility.auto;
                            }

                            KitScrollDemo {
                                name: "on-hover";
                                arrows: ScrollBarArrows.on-hover;
                                visibility: ScrollBarVisibility.auto;
                            }

                            KitScrollDemo {
                                name: "always";
                                arrows: ScrollBarArrows.always;
                                visibility: ScrollBarVisibility.auto;
                            }
                        }

                        KitRow {
                            name: "track click";

                            KitScrollDemo {
                                name: "page";
                                track-click: ScrollBarTrackClick.page;
                                visibility: ScrollBarVisibility.auto;
                            }

                            KitScrollDemo {
                                name: "jump";
                                track-click: ScrollBarTrackClick.jump;
                                visibility: ScrollBarVisibility.auto;
                            }

                            KitScrollDemo {
                                name: "track";
                                arrows: ScrollBarArrows.on-hover;
                                visibility: ScrollBarVisibility.auto;
                                track-color: Theme.control;
                            }
                        }

                        KitRow {
                            name: "visibility";

                            KitScrollDemo {
                                name: "scroll";
                            }

                            KitScrollDemo {
                                name: "auto";
                                visibility: ScrollBarVisibility.auto;
                            }

                            KitScrollDemo {
                                name: "always, fits";
                                lines: 3;
                                arrows: ScrollBarArrows.always;
                                visibility: ScrollBarVisibility.always;
                                track-color: Theme.control;
                            }
                        }

                        KitRow {
                            name: "other";

                            KitScrollDemo {
                                name: "horizontal";
                                orientation: Orientation.horizontal;
                                arrows: ScrollBarArrows.on-hover;
                                visibility: ScrollBarVisibility.auto;
                            }

                            KitScrollDemo {
                                name: "disabled";
                                orientation: Orientation.horizontal;
                                visibility: ScrollBarVisibility.auto;
                                enabled: false;
                            }

                            KitScrollDemo {
                                name: "disabled";
                                visibility: ScrollBarVisibility.auto;
                                enabled: false;
                            }
                        }
                    }
                }
            }

            ScrollBar {
                x: parent.width - self.width;
                height: parent.height;
                value <=> flick.content-y;
                content-length: flick.content-height;
                visible-length: flick.height;
            }
        }
    }
}

// Spacing, sizes, radii, borders, opacity and layers. Values: `docs/design-system.md` § 3.4–§ 3.9, § 3.11, § 2.1.
// Every literal length of the interface lives in `tokens/` (rule `literal-length`).

export global Size {
    // Set by Rust from Settings › Appearance › Density.
    in-out property <bool> compact: false;

    // Spacing grid (§ 3.4)
    out property <length> space-2: 2px;
    out property <length> space-4: 4px;
    out property <length> space-6: 6px;
    out property <length> space-8: 8px;
    out property <length> space-10: 10px;
    out property <length> space-12: 12px;
    out property <length> space-16: 16px;
    out property <length> space-20: 20px;
    out property <length> space-24: 24px;
    out property <length> space-32: 32px;
    out property <length> space-48: 48px;

    // Spacing roles (§ 3.4)
    out property <length> card-pad: 10px;
    out property <length> dialog-pad: 16px;
    out property <length> dialog-gap: 12px;
    out property <length> menu-pad: 4px;
    out property <length> item-pad-x: 8px;
    out property <length> field-pad-x: 6px;
    out property <length> button-pad-x: 10px;
    out property <length> button-pad-x-icon: 8px;
    out property <length> label-gap: 6px;
    out property <length> group-gap: 8px;
    out property <length> section-gap: 16px;
    out property <length> tooltip-pad-y: 4px;
    out property <length> tooltip-pad-x: 8px;

    // Density (§ 3.5): normal / compact
    out property <length> control-sm: compact ? 20px : 24px;
    out property <length> control: compact ? 24px : 28px;
    out property <length> control-lg: compact ? 28px : 32px;
    out property <length> row: compact ? 18px : 22px;
    out property <length> header-row: compact ? 20px : 24px;
    out property <length> toolbar: compact ? 32px : 36px;
    out property <length> tabbar: compact ? 24px : 28px;
    out property <length> statusbar: compact ? 20px : 22px;
    out property <length> menu-item: compact ? 22px : 24px;
    out property <length> icon: compact ? 14px : 16px;
    out property <length> indent: compact ? 14px : 16px;
    out property <length> cell-pad-x: compact ? 4px : 6px;
    out property <length> panel-pad: compact ? 6px : 8px;
    out property <length> tool-gap: compact ? 2px : 4px;
    out property <length> bar-h: compact ? 4px : 6px;

    // Fixed control sizes (§ 3.12, § 5.2)
    out property <length> icon-sm: 12px;
    out property <length> button-min-w: 64px;
    // No upper bound: the `max-width` of what may grow as far as its layout lets it (Slint has no infinity literal).
    out property <length> unbounded: 1000000px;
    // The empty state's call to action: one per screen, same in both densities.
    out property <length> control-hero: 40px;
    out property <length> icon-hero: 18px;
    out property <length> button-pad-x-hero: 20px;
    out property <length> button-hero-min-w: 160px;
    // Pending design: the gap between a segmented control's frame and its chosen segment (§ 5.6).
    out property <length> segment-inset: 2px;
    // Pending design: how narrow a text segment may get before its label is cut with «…» (§ 5.6).
    out property <length> segment-min-w: 40px;
    // The active tab's underline, drawn inside the bar's bottom (§ 5.7).
    out property <length> tab-indicator: 2px;
    // Pending design: a tab's side padding around its label (§ 5.7 gives the text, not the room around it).
    out property <length> tab-pad-x: 10px;
    // Pending design: how narrow a tab may get before its label is cut with «…» (§ 5.7).
    out property <length> tab-min-w: 40px;

    // Choice controls (§ 5.8): the check box, the radio button, the switch.
    out property <length> checkbox: 14px;
    out property <length> checkbox-bar-h: 2px;
    out property <length> switch-w: 28px;
    out property <length> switch-h: 16px;
    out property <length> switch-knob: 12px;
    // Pending design: the check's side inside the box (§ 5.8 names the icon, not its size).
    out property <length> checkbox-check: 12px;
    // Pending design: the length of the indeterminate bar (§ 5.8 gives its 2 px thickness only).
    out property <length> checkbox-bar-w: 8px;
    // Pending design: the dot of a chosen radio button (§ 5.8: «the same, circle-shaped»).
    out property <length> radio-mark: 6px;
    // Pending design: how tall a choice row is, so the whole row is an easy target (§ 5.8 gives the box only).
    out property <length> choice-h: control-sm;
    // Pending design: the gap between the radio buttons of a horizontal group.
    out property <length> choice-gap-x: 16px;

    // Badge, Kbd, Chip, Breadcrumb (§ 5.13–5.15, § 5.26)
    out property <length> badge-h: 16px;
    out property <length> badge-pad-x: 4px;
    // Pending design: the gap between a badge's icon and its text (§ 5.14 gives the icon, not the gap).
    out property <length> badge-gap: 2px;
    out property <length> kbd-pad-x: 4px;
    // Pending design: a key cap's height, the caption's line and its two edges, so the text sits inside them (§ 5.26
    // gives none); as wide at least, so a one-letter key is square (shadcn's Kbd).
    out property <length> kbd-h: 18px;
    // Pending design: the gap between the key caps of a shortcut (shadcn's KbdGroup, 4 px).
    out property <length> kbd-gap: 4px;
    // The chip's `x`: its own hit area (§ 5.15), centred on the chip's right end.
    out property <length> chip-remove: 16px;
    // The colour swatch of a toggle chip (§ 5.15, § 6.6).
    out property <length> chip-swatch: 8px;
    // Pending design: a chip's side padding (§ 5.15 gives none).
    out property <length> chip-pad-x: 8px;
    // Pending design: how narrow a chip may get before its label is cut with «…».
    out property <length> chip-min-w: 48px;
    // Pending design: a breadcrumb segment's side padding, tighter than a button's so the path stays compact.
    out property <length> breadcrumb-pad-x: 4px;
    // Pending design: how narrow the last breadcrumb segment may get before its name is cut with «…».
    out property <length> breadcrumb-min-w: 48px;

    // OptionCard, EmptyState, Card (§ 5.9, § 5.22, § 5.23)
    // Pending design: the gap between option cards, stacked or side by side.
    out property <length> option-card-gap: 8px;
    // Pending design: the gap between an option card's title line and its description.
    out property <length> option-card-text-gap: 2px;
    // Pending design: the width an option card asks for; side by side the cards share the row equally from it.
    out property <length> option-card-w: 240px;
    // The empty state's icon (§ 5.22).
    out property <length> empty-icon: 32px;
    // Pending design: the gap between the empty state's icon, title, description and content.
    out property <length> empty-gap: 8px;
    // Pending design: how wide the empty state's title and description run before they wrap, so a wide area keeps
    // them a readable block (a small dialog's width).
    out property <length> empty-w: dialog-sm;
    // Pending design: the gap between a card's header and its content, and between the blocks of its content.
    out property <length> card-gap: 8px;

    // Fixed sizes (§ 3.5)
    out property <length> side-panel: 300px;
    out property <length> side-panel-min: 220px;
    out property <length> side-panel-max: 480px;
    out property <length> treemap-min: 120px;
    out property <length> table-min: 120px;
    out property <length> splitter-hit: 6px;
    out property <length> scrollbar: 10px;
    out property <length> scroll-thumb: 6px;
    out property <length> scroll-thumb-hover: 8px;
    // Pending design: the shortest the scroll bar's thumb gets on a very long content, so it stays easy to grab.
    out property <length> scroll-thumb-min: 24px;
    // Pending design: the side of a scroll bar's arrow (a filled triangle, as Windows 11 draws it).
    out property <length> scroll-arrow: 6px;
    // Pending design: how far a scroll bar's arrow moves the content, one table row (a page is the visible length).
    out property <length> scroll-step: row;
    out property <length> swatch: 10px;
    out property <length> bar-w: 56px;
    // The search field narrows to this below 1100 px of window width (§ 2.1).
    out property <length> search-w-min: 200px;
    out property <length> search-w: 320px;
    out property <length> search-w-max: 400px;
    // Pending design: a text field's width where its layout does not set one, and the narrowest it gets (§ 5.4
    // gives neither; in a dialog it fills its column).
    out property <length> field-w: 240px;
    out property <length> field-w-min: 80px;
    // Pending design: the gap between a field's label, its box and its help or error message (§ 5.4 gives none).
    out property <length> field-gap: 4px;
    out property <length> drive-picker-w: 232px;
    out property <length> dialog-sm: 400px;
    out property <length> dialog-md: 520px;
    out property <length> dialog-lg: 680px;
    out property <length> menu-min: 200px;
    out property <length> menu-max: 360px;
    out property <length> tooltip-max: 320px;
    // Popups stay this far inside the window's edges (§ 3.11).
    out property <length> popup-margin: 8px;
    // Pending design: the gap between a popup and the button that opened it (§ 3.11 gives 4 px for the status
    // bar's popovers only).
    out property <length> popup-gap: 4px;
    // Pending design: the radio item's dot (§ 5.16 names the item, not its mark).
    out property <length> radio-dot: 6px;
    out property <length> toast-w: 360px;

    // Window (§ 2.1)
    out property <length> window-w: 1280px;
    out property <length> window-h: 800px;
    out property <length> window-min-w: 960px;
    out property <length> window-min-h: 600px;
    out property <length> titlebar: 32px;
    // Pending design: caption buttons as wide as Windows' own, glyphs 10 px.
    out property <length> caption-button-w: 46px;
    out property <length> caption-glyph: 10px;

    // Radii (§ 3.6)
    out property <length> radius-badge: 2px;
    out property <length> radius-control: 2px;
    out property <length> radius-button: 4px;
    out property <length> radius-card: 3px;
    out property <length> radius-panel: 4px;
    out property <length> radius-swatch: 2px;
    out property <length> radius-bar: 1px;
    // Pending design: the highlight of a menu or list item (§ 5.16 gives its colour, not its corners).
    out property <length> radius-item: 2px;

    // Borders and focus (§ 3.7)
    out property <length> border-hairline: 1px;
    out property <length> border-focus: 2px;
    out property <length> border-selection: 2px;
    out property <length> border-cursor: 1px;
    // The focus ring sits this far outside the control's edge (§ 3.7).
    out property <length> focus-gap: 1px;

    // Elevation (§ 3.8): shadows of levels 1 and 2
    out property <length> shadow-1-y: 4px;
    out property <length> shadow-1-blur: 16px;
    out property <length> shadow-2-y: 16px;
    out property <length> shadow-2-blur: 48px;

    // Opacity (§ 3.9)
    out property <float> disabled: 0.40;
    out property <float> pending: 0.55;
    out property <float> dimmed: 0.30;

    // The unit the Kit shows lengths in (§ 9): a length divided by it is its number of logical pixels.
    out property <length> unit: 1px;

    // Layers inside the content (§ 3.11)
    out property <float> z-sticky-header: 1;
    out property <float> z-splitter: 2;
    out property <float> z-drag-ghost: 3;
    out property <float> z-notice: 5;
    out property <float> z-dialog: 10;
}

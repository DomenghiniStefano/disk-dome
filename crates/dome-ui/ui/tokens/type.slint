// Typography. Values: `docs/design-system.md` § 3.3. Only `Label` (and these tokens) set font properties.

export enum TypeStep {
    display,
    title,
    body,
    body-strong,
    caption,
    caption-strong,
    map-name,
    map-name-xs,
    overline,
    mono }

export global Type {
    // Segoe UI: its default figures are tabular at 400 and 700 (decision 8, test 7).
    out property <string> family: "Segoe UI";
        out property <string> family-mono: "Cascadia Mono";

        public pure function family-of(step: TypeStep) -> string {
            return step == TypeStep.mono ? family-mono : family;
        }

        public pure function size(step: TypeStep) -> length {
            return step == TypeStep.display ? 20px : step == TypeStep.title ? 15px : step == TypeStep.body
                || step == TypeStep.body-strong ? 13px : step == TypeStep.map-name || step == TypeStep.overline ? 11px
                : step == TypeStep.map-name-xs ? 10px : 12px;
        }

        public pure function line(step: TypeStep) -> length {
            return step == TypeStep.display ? 26px : step == TypeStep.title ? 20px : step == TypeStep.body
                || step == TypeStep.body-strong ? 18px : step == TypeStep.map-name ? 13px : step == TypeStep.map-name-xs
                ? 11px : step == TypeStep.overline ? 14px : 16px;
        }

        // 400 and 700 only (decision 8, owner 2026-11-26): Semibold 600's digits are proportional, so a strong total
    // would not line up with the rows above it; Bold 700's are tabular.
    out property <int> weight-regular: 400;
        out property <int> weight-bold: 700;

        public pure function weight(step: TypeStep) -> int {
            return step == TypeStep.body || step == TypeStep.caption || step == TypeStep.mono ? weight-regular
                : weight-bold;
        }

        public pure function tracking(step: TypeStep) -> length {
            return step == TypeStep.display ? -0.2px : step == TypeStep.overline ? 0.6px : 0px;
        }
    }

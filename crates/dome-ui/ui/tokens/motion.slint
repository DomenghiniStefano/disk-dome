// Durations and the easing. Values: `docs/design-system.md` § 3.10.

export global Motion {
    // Set by Rust when Windows' «Animation effects» is off: every duration becomes 0.
    in-out property <bool> reduced: false;

    out property <duration> fast: reduced ? 0ms : 90ms;
    out property <duration> base: reduced ? 0ms : 140ms;
    out property <duration> slow: reduced ? 0ms : 200ms;
    // The indeterminate progress segment crosses the whole track in this time, at an even pace (§ 5.21: `slow` × 6);
    // 0 with reduced motion, and the segment stays still.
    out property <duration> progress-sweep: slow * 6;
    // The search applies after the typing rests this long; Enter applies at once (§ 5.4).
    out property <duration> search-rest: 150ms;
    // Pending design: how long the scroll bar stays after the scrolling stops (§ 5.24 says only «while scrolling»).
    out property <duration> scrollbar-linger: 1000ms;
    // Pending design: a held scroll bar arrow or track starts repeating after this, then repeats every interval.
    out property <duration> repeat-delay: 400ms;
    out property <duration> repeat-interval: 50ms;
    // A tooltip waits for the mouse to rest even with reduced motion; on keyboard focus it shows at once.
    out property <duration> tooltip-delay: 500ms;
    // Pending design: after a tooltip closes, another one within this time opens without waiting (Radix's 300 ms).
    out property <duration> tooltip-skip: 300ms;
    // Pending design: how long the pointer rests on an item before its submenu opens (Windows' default, 400 ms).
    out property <duration> submenu-delay: 400ms;
    // Pending design: letters typed within this time make one search in a menu; a longer pause starts a new one.
    out property <duration> typeahead-reset: 1000ms;
    // The unit the Kit shows durations in (§ 9): a duration divided by it is its number of milliseconds.
    out property <duration> unit: 1ms;
    out property <easing> ease-out: cubic-bezier(0.2, 0.8, 0.2, 1);
    // Menus and tooltips rise this much while they fade in; dialogs grow from this scale.
    out property <length> rise: 4px;
    // The rise moves at an even pace: on whole pixels, an eased 4 px jumps (§ 3.10).
    out property <easing> rise-easing: linear;
    out property <float> dialog-scale-from: 0.98;
}

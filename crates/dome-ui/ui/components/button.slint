// Button (§ 5.2): five variants, four sizes; text, icon + text, text + trailing icon, or icon only (square,
// `accessible-label` mandatory: rule `icon-label`). It hugs its content with a minimum width, so Italian labels grow
// it; short of room it shrinks to that minimum and cuts the label with «…», whose full text the tooltip then says.
// `ButtonWidth.fill` takes the whole width its layout gives.

import { Size } from "../tokens/size.slint";
import { Theme } from "../tokens/theme.slint";
import { Motion } from "../tokens/motion.slint";
import { TypeStep } from "../tokens/type.slint";
import {
    ButtonVariant,
    ButtonSize,
    ButtonWidth,
    IconSize,
    InkTone,
    KitState,
} from "../enums.slint";
import { Pressable } from "../primitives/pressable.slint";
import { FocusRing } from "../primitives/focus-ring.slint";
import { Label } from "label.slint";
import { Icon } from "icon.slint";
import { Tooltip } from "tooltip.slint";

// Variant and size → look. One place, so the Kit and the screens can never disagree.
global ButtonLook {
    public pure function fill(variant: ButtonVariant, hovered: bool, pressed: bool) -> color {
        if (variant == ButtonVariant.primary) {
            return pressed ? Theme.accent-pressed : hovered ? Theme.accent-hover : Theme.accent;
        }
        if (variant == ButtonVariant.danger) {
            return pressed ? Theme.danger-pressed : hovered ? Theme.danger-hover : Theme.danger;
        }
        // secondary, ghost, danger-ghost: neutral hover and press; only secondary has a fill at rest.
        return pressed ? Theme.control-pressed : hovered ? Theme.control-hover
            : variant == ButtonVariant.secondary ? Theme.control : transparent;
    }

    public pure function tone(variant: ButtonVariant) -> InkTone {
        return variant == ButtonVariant.primary ? InkTone.on-accent
            : variant == ButtonVariant.danger ? InkTone.on-danger
            : variant == ButtonVariant.ghost ? InkTone.muted
            : variant == ButtonVariant.danger-ghost ? InkTone.danger
            : InkTone.normal;
    }

    public pure function step(variant: ButtonVariant, size: ButtonSize) -> TypeStep {
        return size == ButtonSize.hero ? TypeStep.title
            : variant == ButtonVariant.primary || variant == ButtonVariant.danger ? TypeStep.body-strong
            : TypeStep.body;
    }

    public pure function height(size: ButtonSize) -> length {
        return size == ButtonSize.small ? Size.control-sm
            : size == ButtonSize.large ? Size.control-lg
            : size == ButtonSize.hero ? Size.control-hero
            : Size.control;
    }
}

export component Button {
    in property <string> text;
    in property <image> icon;
    // After the label, as the chevron of a button that opens a list; shown only with a text.
    in property <image> icon-end;
    in property <ButtonVariant> variant: ButtonVariant.secondary;
    in property <ButtonSize> size: ButtonSize.normal;
    in property <ButtonWidth> width-mode: ButtonWidth.hug;
    in property <bool> enabled: true;
    // The Kit window only (§ 9).
    in property <KitState> kit-state: KitState.live;
    // Said on hover and keyboard focus (§ 5.17); an icon-only button says its `accessible-label` when this is empty.
    // On a disabled button, the reason.
    in property <string> tooltip;
    in property <string> tooltip-shortcut;

    // Whether its tooltip is showing (the tests read it).
    out property <bool> tooltip-shown: tip.shown;

    callback clicked;

    property <bool> has-text: root.text != "";
    property <bool> has-icon: root.icon.width > 0;
    property <bool> has-icon-end: root.has-text && root.icon-end.width > 0;
    property <bool> icon-only: root.has-icon && !root.has-text;
    // The label is cut: the tooltip says it whole.
    property <bool> cut: root.has-text && root.label-cut;
    // The label sits inside an `if`, so its `cut` is copied here to be read.
    property <bool> label-cut;
    property <bool> hero: root.size == ButtonSize.hero;
    property <length> pad-x: root.hero ? Size.button-pad-x-hero : Size.button-pad-x;
    property <length> min-w: root.hero ? Size.button-hero-min-w : Size.button-min-w;

    height: ButtonLook.height(root.size);
    // Icon only: square. With text: the content, never below the minimum; short of room it gives way down to the
    // minimum (or the content, when that is smaller) and the label is cut.
    min-width: root.has-text ? min(root.min-w, content.preferred-width) : root.height;
    preferred-width: root.has-text ? max(root.min-w, content.preferred-width) : root.height;
    max-width: root.width-mode == ButtonWidth.fill && root.has-text ? Size.unbounded : self.preferred-width;
    opacity: root.enabled ? 1 : Size.disabled;

    forward-focus: pressable;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-description: root.tooltip;
    accessible-action-default => {
        root.clicked();
    }

    Rectangle {
        border-radius: Size.radius-button;
        background: ButtonLook.fill(root.variant, pressable.hovered, pressable.pressed);
        animate background { duration: Motion.fast; }
    }

    content := HorizontalLayout {
        alignment: center;
        spacing: Size.label-gap;
        // The side with an icon is a little tighter (§ 3.4), except on the hero button.
        padding-left: !root.has-text ? 0 : root.has-icon && !root.hero ? Size.button-pad-x-icon : root.pad-x;
        padding-right: !root.has-text ? 0 : root.has-icon-end && !root.hero ? Size.button-pad-x-icon : root.pad-x;

        if root.has-icon: VerticalLayout {
            alignment: center;

            Icon {
                source: root.icon;
                size: root.hero ? IconSize.hero : IconSize.normal;
                tone: ButtonLook.tone(root.variant);
            }
        }
        if root.has-text: Label {
            text: root.text;
            step: ButtonLook.step(root.variant, root.size);
            tone: ButtonLook.tone(root.variant);
            accessible-role: none;

            changed cut => {
                root.label-cut = self.cut;
            }
            init => {
                root.label-cut = self.cut;
            }
        }
        if root.has-icon-end: VerticalLayout {
            alignment: center;

            Icon {
                source: root.icon-end;
                size: root.hero ? IconSize.hero : IconSize.normal;
                tone: ButtonLook.tone(root.variant);
            }
        }
    }

    if pressable.show-focus: FocusRing {
        radius: Size.radius-button;
    }

    pressable := Pressable {
        enabled: root.enabled;
        kit-state: root.kit-state;
        activated => {
            root.clicked();
        }
        // Esc puts the tooltip away (§ 5.17); other keys are not the button's.
        key-pressed(event) => {
            if (event.text == Key.Escape && tip.shown) {
                tip.dismiss();
                return accept;
            }
            return reject;
        }
    }

    // After the pointer area, so over a disabled button it can watch the pointer itself.
    tip := Tooltip {
        text: root.tooltip != "" ? root.tooltip : root.icon-only ? root.accessible-label : root.cut ? root.text : "";
        shortcut: root.tooltip-shortcut;
        hovered: root.kit-state == KitState.live && pressable.hovered;
        focused: root.kit-state == KitState.live && pressable.show-focus;
        pressed: pressable.pressed;
        watch-pointer: !root.enabled;
    }
}

// Checkbox (§ 5.8): a box of `checkbox` side, radius `control`, a 1 px `line-strong` edge; checked, an `accent` fill
// with a `check` in `on-accent`; indeterminate, the same fill with a 2 px bar. The label on its right (`body`), the
// whole row clickable. Space flips it, Enter does not (it belongs to the dialog's default button), as WAI-ARIA and
// Radix; a click on an indeterminate box ticks it. One line by default, cut with «…» and said whole in the tooltip;
// `wrap` lets a long label run onto more lines beside the box.

import { Size } from "../tokens/size.slint";
import { Theme } from "../tokens/theme.slint";
import { Motion } from "../tokens/motion.slint";
import { Icons } from "../icons/icons.slint";
import {
    CheckboxState,
    InkTone,
    KitState,
    LabelWrap,
} from "../enums.slint";
import { Pressable } from "../primitives/pressable.slint";
import { FocusRing } from "../primitives/focus-ring.slint";
import { ChoiceRow, ChoiceLook } from "choice-row.slint";
import { Icon } from "icon.slint";
import { Tooltip } from "tooltip.slint";

export component Checkbox {
    in property <string> text;
    // Written by the box when the user flips it, and by the screen to set it (a group's box follows its rows): both
    // sides write.
    in-out property <CheckboxState> state: CheckboxState.unchecked;
    in property <bool> enabled: true;
    in property <LabelWrap> wrap: LabelWrap.none;
    // The Kit window only (§ 9).
    in property <KitState> kit-state: KitState.live;
    // Said on hover and keyboard focus (§ 5.17); a cut label says its text. On a disabled box, the reason.
    in property <string> tooltip;

    // Whether its tooltip is showing (the tests read it).
    out property <bool> tooltip-shown: tip.shown;

    // The user flipped it: `checked` or `unchecked`, never `indeterminate`.
    callback toggled(state: CheckboxState);

    property <bool> marked: root.state != CheckboxState.unchecked;

    function flip() {
        root.state = root.state == CheckboxState.checked ? CheckboxState.unchecked : CheckboxState.checked;
        root.toggled(root.state);
    }

    min-width: row.min-width;
    preferred-width: row.preferred-width;
    max-width: row.max-width;
    min-height: row.min-height;
    preferred-height: row.preferred-height;
    max-height: row.max-height;
    opacity: root.enabled ? 1 : Size.disabled;

    forward-focus: pressable;
    accessible-role: checkbox;
    accessible-label: root.text;
    accessible-checkable: true;
    // Slint 1.19 has no «mixed» state: an indeterminate box reads as not checked.
    accessible-checked: root.state == CheckboxState.checked;
    accessible-enabled: root.enabled;
    accessible-description: root.tooltip;
    accessible-action-default => {
        root.flip();
    }

    row := ChoiceRow {
        width: 100%;
        height: 100%;
        text: root.text;
        wrap: root.wrap;
        mark-width: Size.checkbox;
        mark-height: Size.checkbox;

        Rectangle {
            border-radius: Size.radius-control;
            border-width: Size.border-hairline;
            border-color: ChoiceLook.edge(root.marked, pressable.hovered, pressable.pressed);
            background: ChoiceLook.fill(root.marked, pressable.hovered, pressable.pressed);
            animate background, border-color { duration: Motion.fast; }

            if root.state == CheckboxState.checked: Icon {
                source: Icons.check;
                side: Size.checkbox-check;
                tone: InkTone.on-accent;
            }

            if root.state == CheckboxState.indeterminate: Rectangle {
                width: Size.checkbox-bar-w;
                height: Size.checkbox-bar-h;
                background: Theme.on-accent;
            }
        }

        if pressable.show-focus: FocusRing {
            radius: Size.radius-control;
        }
    }

    pressable := Pressable {
        enabled: root.enabled;
        kit-state: root.kit-state;
        enter-activates: false;
        activated => {
            root.flip();
        }
        // Esc puts the tooltip away (§ 5.17); other keys are not the box's.
        key-pressed(event) => {
            if (event.text == Key.Escape && tip.shown) {
                tip.dismiss();
                return accept;
            }
            return reject;
        }
    }

    // After the pointer area, so over a disabled box it can watch the pointer itself.
    tip := Tooltip {
        text: root.tooltip != "" ? root.tooltip : row.cut ? root.text : "";
        hovered: root.kit-state == KitState.live && pressable.hovered;
        focused: root.kit-state == KitState.live && pressable.show-focus;
        pressed: pressable.pressed;
        watch-pointer: !root.enabled;
    }
}

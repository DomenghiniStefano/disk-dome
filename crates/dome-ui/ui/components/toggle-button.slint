// ToggleButton (§ 5.3): a button that stays on, as shadcn's Toggle. Text, icon + text or icon only (square,
// `accessible-label` mandatory: rule `icon-label`); `ghost` or `outline` (a hairline `line` edge); three sizes.
// Checked: `accent-soft` fill, icon and text in `accent-text`. It hugs its content; short of room it gives way down
// to a square and cuts the label with «…», whose full text the tooltip then says.

import { Size } from "../tokens/size.slint";
import { Theme } from "../tokens/theme.slint";
import { Motion } from "../tokens/motion.slint";
import { TypeStep } from "../tokens/type.slint";
import {
    ToggleSize,
    ToggleVariant,
    InkTone,
    KitState,
} from "../enums.slint";
import { Pressable } from "../primitives/pressable.slint";
import { FocusRing } from "../primitives/focus-ring.slint";
import { ButtonContent } from "button-content.slint";
import { Tooltip } from "tooltip.slint";

global ToggleLook {
    public pure function fill(checked: bool, hovered: bool, pressed: bool) -> color {
        return checked ? Theme.accent-soft : pressed ? Theme.control-pressed : hovered ? Theme.control-hover
            : transparent;
    }

    public pure function edge(variant: ToggleVariant) -> length {
        return variant == ToggleVariant.outline ? Size.border-hairline : 0;
    }

    public pure function side(size: ToggleSize) -> length {
        return size == ToggleSize.small ? Size.control-sm
            : size == ToggleSize.large ? Size.control-lg
            : Size.control;
    }
}

export component ToggleButton {
    in property <string> text;
    in property <image> icon;
    // Written by the button when the user flips it, and by the screen to set it: both sides write.
    in-out property <bool> checked;
    in property <ToggleVariant> variant: ToggleVariant.ghost;
    in property <ToggleSize> size: ToggleSize.normal;
    in property <bool> enabled: true;
    // The Kit window only (§ 9).
    in property <KitState> kit-state: KitState.live;
    // Said on hover and keyboard focus (§ 5.17); an icon-only button says its `accessible-label` when this is empty,
    // a cut one its text. On a disabled button, the reason.
    in property <string> tooltip;
    in property <string> tooltip-shortcut;

    // Whether its tooltip is showing (the tests read it).
    out property <bool> tooltip-shown: tip.shown;

    callback toggled(checked: bool);

    property <bool> has-text: root.text != "";
    property <bool> icon-only: root.icon.width > 0 && !root.has-text;

    height: ToggleLook.side(root.size);
    // Icon only: square. With text: the content; short of room it gives way down to a square and the label is cut.
    min-width: root.has-text ? min(root.height, content.preferred-width) : root.height;
    preferred-width: root.has-text ? max(root.height, content.preferred-width) : root.height;
    max-width: self.preferred-width;
    opacity: root.enabled ? 1 : Size.disabled;

    forward-focus: pressable;
    accessible-role: button;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled;
    accessible-description: root.tooltip;
    accessible-action-default => {
        root.flip();
    }

    function flip() {
        root.checked = !root.checked;
        root.toggled(root.checked);
    }

    Rectangle {
        border-radius: Size.radius-button;
        border-width: ToggleLook.edge(root.variant);
        border-color: Theme.line;
        background: ToggleLook.fill(root.checked, pressable.hovered, pressable.pressed);
        animate background { duration: Motion.fast; }
    }

    content := ButtonContent {
        text: root.text;
        icon: root.icon;
        step: TypeStep.body;
        tone: root.checked ? InkTone.accent : InkTone.muted;
    }

    if pressable.show-focus: FocusRing {
        radius: Size.radius-button;
    }

    pressable := Pressable {
        enabled: root.enabled;
        kit-state: root.kit-state;
        activated => {
            root.flip();
        }
        // Esc puts the tooltip away (§ 5.17); other keys are not the button's.
        key-pressed(event) => {
            if (event.text == Key.Escape && tip.shown) {
                tip.dismiss();
                return accept;
            }
            return reject;
        }
    }

    // After the pointer area, so over a disabled button it can watch the pointer itself.
    tip := Tooltip {
        text: root.tooltip != "" ? root.tooltip : root.icon-only ? root.accessible-label : content.cut ? root.text : "";
        shortcut: root.tooltip-shortcut;
        hovered: root.kit-state == KitState.live && pressable.hovered;
        focused: root.kit-state == KitState.live && pressable.show-focus;
        pressed: pressable.pressed;
        watch-pointer: !root.enabled;
    }
}

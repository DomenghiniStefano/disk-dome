// SegmentedControl (§ 5.6): 2–4 items in one frame, one Tab stop; the arrow keys, Home and End move the choice,
// skipping disabled segments, and `wrap-around` goes round the ends (as Radix). A segment shows its text, an icon and
// its text, or its icon only (its text is then its accessible name and its tooltip). The chosen segment is
// `raised` with `ink`, the others `ink-muted`; a disabled one is faded and says why in its tooltip. It hugs its
// segments, or fills its layout's width split equally (`SegmentedWidth.fill`); short of room, the segments give way
// down to `segment-min-w` and cut their labels with «…», whose full text the tooltip then says.
//
// Slint functions have no loops, so skipping the disabled segments is answered by Rust through `SegmentedNav`
// (`crates/dome-ui/src/segmented.rs`, wired by `segmented_nav!` on every window).

import { Size } from "../tokens/size.slint";
import { Theme } from "../tokens/theme.slint";
import { Motion } from "../tokens/motion.slint";
import {
    InkTone,
    KitState,
    SegmentedSize,
    SegmentedWidth,
} from "../enums.slint";
import { InputMode } from "../input-mode.slint";
import { Pressable } from "../primitives/pressable.slint";
import { FocusTarget } from "../primitives/focus-target.slint";
import { FocusRing } from "../primitives/focus-ring.slint";
import { ButtonContent } from "button-content.slint";
import { Tooltip } from "tooltip.slint";

// One segment. Only `text` is needed; the rest is empty or false by default.
export struct SegmentedItem {
    // Shown, and always its accessible name (with `icon-only` too).
    text: string,
    icon: image,
    // Only the icon shows; the text is said by the tooltip and screen readers.
    icon-only: bool,
    // Said on hover and keyboard focus (§ 5.17); on a disabled segment, why.
    tooltip: string,
    disabled: bool,
}

// The answers Slint cannot compute (`crates/dome-ui/src/segmented.rs`).
export global SegmentedNav {
    // The nearest enabled segment after `from` (`forward`) or before it; `wrap` goes round the ends, otherwise the
    // choice stays. With `from` out of range, the first (forward) or last enabled one. -1 with none enabled.
    pure callback step(items: [SegmentedItem], from: int, forward: bool, wrap: bool) -> int;
    // The first or the last enabled segment, -1 with none.
    pure callback edge(items: [SegmentedItem], last: bool) -> int;
}

export component SegmentedControl {
    in property <[SegmentedItem]> items;
    // Written by the control when the user chooses, and by the screen to set the choice: both sides write. Out of
    // range, no segment is chosen.
    in-out property <int> current-index: 0;
    in property <SegmentedSize> size: SegmentedSize.normal;
    in property <SegmentedWidth> width-mode: SegmentedWidth.hug;
    in property <bool> enabled: true;
    // The arrow keys go round the ends.
    in property <bool> wrap-around: true;
    // The Kit window only (§ 9): hover and pressed are shown on the segment after the chosen one.
    in property <KitState> kit-state: KitState.live;

    // The segment whose tooltip shows, -1 with none (the tests read it).
    out property <int> tooltip-index: -1;

    // The user chose another item.
    callback selected(index: int);

    property <int> kit-segment: Math.mod(root.current-index + 1, max(1, root.items.length));
    // The segment whose tooltip Esc put away, until the pointer and the focus leave it.
    property <int> hushed: -1;

    function choose(index: int) {
        if (index >= 0 && index < root.items.length && index != root.current-index && !root.items[index].disabled) {
            root.current-index = index;
            root.selected(index);
        }
    }

    height: root.size == SegmentedSize.small ? Size.control-sm : Size.control;
    min-width: row.min-width;
    preferred-width: row.preferred-width;
    max-width: root.width-mode == SegmentedWidth.fill ? Size.unbounded : row.preferred-width;
    opacity: root.enabled ? 1 : Size.disabled;

    forward-focus: group;
    accessible-role: radio-group;
    accessible-enabled: root.enabled;

    group := FocusTarget {
        enabled: root.enabled;
        kit-state: root.kit-state;
        key-pressed(event) => {
            if (event.text == Key.LeftArrow || event.text == Key.UpArrow) {
                root.choose(SegmentedNav.step(root.items, root.current-index, false, root.wrap-around));
            } else if (event.text == Key.RightArrow || event.text == Key.DownArrow) {
                root.choose(SegmentedNav.step(root.items, root.current-index, true, root.wrap-around));
            } else if (event.text == Key.Home) {
                root.choose(SegmentedNav.edge(root.items, false));
            } else if (event.text == Key.End) {
                root.choose(SegmentedNav.edge(root.items, true));
            } else if (event.text == Key.Escape && root.tooltip-index >= 0) {
                // Esc puts the tooltip away (§ 5.17).
                root.hushed = root.tooltip-index;
            } else {
                return reject;
            }
            InputMode.keyboard = true;
            return accept;
        }
    }

    Rectangle {
        border-radius: Size.radius-control;
        background: Theme.control;
    }

    row := HorizontalLayout {
        padding: Size.segment-inset;

        for item[index] in root.items: Rectangle {
            property <bool> chosen: index == root.current-index;
            property <bool> live: root.enabled && !item.disabled;
            property <bool> has-icon: item.icon.width > 0;
            property <bool> icon-only: item.icon-only && self.has-icon;
            // The pointer or the keyboard asks for its tooltip, before Esc is heard.
            property <bool> asked: root.kit-state == KitState.live && (segment.hovered || (self.chosen && group.show-focus));

            changed asked => {
                if (!self.asked && root.hushed == index) {
                    root.hushed = -1;
                }
            }

            // Icon only: square. With text: the content, giving way down to the minimum (or the content, when that is
            // smaller). Filling, every segment starts from nothing and takes an equal share.
            horizontal-stretch: 1;
            min-width: self.icon-only ? self.height : min(Size.segment-min-w, content.preferred-width);
            preferred-width: root.width-mode == SegmentedWidth.fill ? 0 : self.icon-only ? self.height : content.preferred-width;
            border-radius: Size.radius-control;
            background: self.chosen ? Theme.raised
                : segment.pressed ? Theme.control-pressed
                : segment.hovered ? Theme.control-hover
                : transparent;
            animate background { duration: Motion.fast; }

            accessible-role: radio-button;
            accessible-label: item.text;
            accessible-description: item.tooltip;
            accessible-enabled: self.live;
            accessible-checkable: true;
            accessible-checked: self.chosen;
            accessible-action-default => {
                root.choose(index);
            }

            content := ButtonContent {
                // Icon only: the text is said by the tooltip and screen readers, not shown.
                text: icon-only ? "" : item.text;
                icon: item.icon;
                tone: chosen ? InkTone.normal : InkTone.muted;
                align: TextHorizontalAlignment.center;
                opacity: item.disabled ? Size.disabled : 1;
            }

            segment := Pressable {
                enabled: live;
                focusable: false;
                kit-state: index == root.kit-segment && root.kit-state != KitState.focus ? root.kit-state : KitState.live;
                activated => {
                    group.focus();
                    root.choose(index);
                }
            }

            // After the pointer area, so over a disabled segment it can watch the pointer itself.
            Tooltip {
                text: item.tooltip != "" ? item.tooltip : icon-only || content.cut ? item.text : "";
                hovered: asked && segment.hovered && root.hushed != index;
                focused: asked && chosen && group.show-focus && root.hushed != index;
                pressed: segment.pressed;
                watch-pointer: !live;

                changed shown => {
                    if (self.shown) {
                        root.tooltip-index = index;
                    } else if (root.tooltip-index == index) {
                        root.tooltip-index = -1;
                    }
                }
            }
        }
    }

    if group.show-focus: FocusRing {
        radius: Size.radius-control;
    }
}

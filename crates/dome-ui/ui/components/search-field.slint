// SearchField (§ 5.4): the `search` icon (another, or none), the text, a clear `x` when not empty, and up to two ToggleButtons inside on
// the right, match case (`case-sensitive`) and regular expression (`regex`). Typing applies after `rest-delay` of
// quiet, Enter at once; Esc clears, a second Esc leaves the field. An invalid pattern turns the edge `danger` and its
// reason shows in a tooltip under the field: at once while the field has the focus, after the delay on hover.

import { Size } from "../tokens/size.slint";
import { Motion } from "../tokens/motion.slint";
import { TypeStep } from "../tokens/type.slint";
import { Icons } from "../icons/icons.slint";
import {
    IconSize,
    InkTone,
    ToggleSize,
    ButtonVariant,
    ButtonSize,
    KitState,
    PopupSide,
    PopupAlign,
    SearchFieldToggles,
} from "../enums.slint";
import { TextEntry } from "../primitives/text-entry.slint";
import { FieldFrame } from "../primitives/field-frame.slint";
import { Icon } from "icon.slint";
import { Label } from "label.slint";
import { Button } from "button.slint";
import { ToggleButton } from "toggle-button.slint";
import { Tooltip } from "tooltip.slint";

export component SearchField {
    // Written by the user typing and by the screen (to fill or clear the search): both sides write.
    in-out property <string> text;
    // Written by the toggles and by the screen (a remembered choice): both sides write.
    in-out property <bool> match-case;
    in-out property <bool> regex;
    in property <string> placeholder;
    // Its name for screen readers; the placeholder when empty.
    in property <string> label;
    // Why the pattern is not valid, set by the owner of the search; empty when it is. A reason is mandatory: the
    // field never turns red without saying why (§ 5.4).
    in property <string> error;
    // Leads the text, decorative (`ink-faint`); an empty image draws none and the text starts at the padding.
    in property <image> icon: Icons.search;
    in property <SearchFieldToggles> toggles: SearchFieldToggles.match-case-and-regex;
    // How long the typing must rest before the search applies.
    in property <duration> rest-delay: Motion.search-rest;
    in property <bool> enabled: true;
    // The Kit window only (§ 9): `focus` shows the focused edge and the ring.
    in property <KitState> kit-state: KitState.live;

    out property <bool> has-focus: entry.has-focus;
    // Whether the error's tooltip shows (the tests read it).
    out property <bool> error-shown: tip.shown;

    // The search to apply: after the typing rests, on Enter, on a toggle, on clearing.
    callback search-requested(text: string);

    property <bool> has-case: root.toggles != SearchFieldToggles.none;
    property <bool> has-regex: root.toggles == SearchFieldToggles.match-case-and-regex;
    property <bool> has-icon: root.icon.width > 0;

    // 320 in the toolbar, down to 200 in a narrow window, up to 400 when there is room (§ 2.1, § 5.4); a screen
    // sets its own widths where the field has another place (a dialog, the command palette).
    min-width: Size.search-w-min;
    preferred-width: Size.search-w;
    max-width: Size.search-w-max;
    horizontal-stretch: 1;
    height: Size.control;
    opacity: root.enabled ? 1 : Size.disabled;

    forward-focus: entry;
    accessible-role: AccessibleRole.search;
    accessible-label: root.label != "" ? root.label : root.placeholder;
    accessible-description: root.error;
    accessible-enabled: root.enabled;

    function apply() {
        rest.running = false;
        root.search-requested(root.text);
    }

    function clear() {
        root.text = "";
        root.apply();
    }

    // Esc clears; on an empty field it hands the focus back.
    FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;
        capture-key-pressed(event) => {
            if (event.text != Key.Escape || !entry.has-focus) {
                return reject;
            }
            if (root.text != "") {
                root.clear();
            } else {
                entry.clear-focus();
            }
            return accept;
        }

        FieldFrame {
            has-focus: entry.has-focus;
            invalid: root.error != "";
            kit-state: root.kit-state;
        }

        HorizontalLayout {
            padding-right: Size.segment-inset;
            spacing: Size.space-4;

            // The icon and the text: a click anywhere here, the icon too, puts the focus in the text; the pointer
            // over it asks for the error's tooltip.
            pointer := TouchArea {
                horizontal-stretch: 1;
                enabled: root.enabled;
                mouse-cursor: MouseCursor.text;
                clicked => {
                    entry.focus();
                }

                HorizontalLayout {
                    padding-left: Size.field-pad-x;
                    spacing: Size.space-4;

                    if root.has-icon: VerticalLayout {
                        alignment: center;

                        Icon {
                            source: root.icon;
                            size: IconSize.normal;
                            tone: InkTone.faint;
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        if root.text == "": Label {
                            width: parent.width;
                            height: parent.height;
                            text: root.placeholder;
                            tone: InkTone.faint;
                            accessible-role: none;
                        }
                        entry := TextEntry {
                            width: parent.width;
                            height: parent.height;
                            text <=> root.text;
                            // A regular expression is read in the mono step (§ 5.4).
                            step: root.has-regex && root.regex ? TypeStep.mono : TypeStep.body;
                            enabled: root.enabled;
                            label: root.accessible-label;
                            edited => {
                                rest.running = false;
                                rest.running = true;
                            }
                            accepted => {
                                root.apply();
                            }
                        }
                    }
                }
            }

            if root.text != "" && root.enabled: VerticalLayout {
                alignment: center;

                Button {
                    icon: Icons.x;
                    variant: ButtonVariant.ghost;
                    size: ButtonSize.small;
                    accessible-label: @tr("Clear the search");
                    tooltip-shortcut: @tr("Esc");
                    clicked => {
                        root.clear();
                        entry.focus();
                    }
                }
            }

            if root.has-case: VerticalLayout {
                alignment: center;

                ToggleButton {
                    icon: Icons.case-sensitive;
                    size: ToggleSize.small;
                    checked <=> root.match-case;
                    enabled: root.enabled;
                    accessible-label: @tr("Match case");
                    toggled => {
                        root.apply();
                    }
                }
            }

            if root.has-regex: VerticalLayout {
                alignment: center;

                ToggleButton {
                    icon: Icons.regex;
                    size: ToggleSize.small;
                    checked <=> root.regex;
                    enabled: root.enabled;
                    accessible-label: @tr("Regular expression");
                    toggled => {
                        root.apply();
                    }
                }
            }
        }
    }

    // Under the field, lined up with its start, as § 6.6 draws the error's bubble.
    tip := Tooltip {
        text: root.error;
        side: PopupSide.bottom;
        align: PopupAlign.start;
        hovered: root.kit-state == KitState.live && pointer.has-hover;
        focused: root.kit-state == KitState.live && entry.has-focus;
    }

    rest := Timer {
        interval: root.rest-delay;
        running: false;
        triggered => {
            root.apply();
        }
    }
}

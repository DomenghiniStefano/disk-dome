// SearchField (§ 5.4): the `search` icon, the text, a clear `x` when not empty, and two ToggleButtons inside on the
// right, match case (`case-sensitive`) and regular expression (`regex`). Typing applies after `Motion.search-rest`
// of quiet, Enter at once; Esc clears, a second Esc leaves the field. An invalid pattern turns the edge `danger`.
// Blind spot: the reason of an invalid pattern goes in a tooltip, which waits for the Tooltip component (§ 5.17).

import { Size } from "../tokens/size.slint";
import { Theme } from "../tokens/theme.slint";
import { Motion } from "../tokens/motion.slint";
import { TypeStep } from "../tokens/type.slint";
import { InputMode } from "../input-mode.slint";
import { Icons } from "../icons/icons.slint";
import {
    IconSize,
    InkTone,
    ToggleSize,
    ButtonVariant,
    ButtonSize,
    KitState,
} from "../enums.slint";
import { TextEntry } from "../primitives/text-entry.slint";
import { FocusRing } from "../primitives/focus-ring.slint";
import { Icon } from "icon.slint";
import { Label } from "label.slint";
import { Button } from "button.slint";
import { ToggleButton } from "toggle-button.slint";

export component SearchField {
    in-out property <string> text;
    in-out property <bool> match-case;
    in-out property <bool> regex;
    in property <string> placeholder;
    // Set by the owner of the search when the pattern does not compile.
    in property <bool> invalid;
    in property <bool> enabled: true;
    // The Kit window only (§ 9): `focus` shows the focused edge and the ring.
    in property <KitState> kit-state: KitState.live;

    // The search to apply: after the typing rests, on Enter, on a toggle, on clearing.
    callback search(text: string);

    property <bool> focused: root.kit-state == KitState.focus
        || (root.kit-state == KitState.live && entry.has-focus);

    // 320 in the toolbar, down to 200 in a narrow window, up to 400 when there is room (§ 2.1, § 5.4).
    min-width: Size.search-w-min;
    preferred-width: Size.search-w;
    max-width: Size.search-w-max;
    horizontal-stretch: 1;
    height: Size.control;
    opacity: root.enabled ? 1 : Size.disabled;

    forward-focus: entry;
    accessible-role: AccessibleRole.search;
    accessible-label: root.placeholder;

    function apply() {
        rest.running = false;
        root.search(root.text);
    }

    // Esc clears; on an empty field it hands the focus back.
    FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;
        capture-key-pressed(event) => {
            if (event.text != Key.Escape || !entry.has-focus) {
                return reject;
            }
            if (root.text != "") {
                root.text = "";
                root.apply();
            } else {
                entry.clear-focus();
            }
            return accept;
        }

        Rectangle {
            background: Theme.field;
            border-width: Size.border-hairline;
            border-color: root.invalid ? Theme.danger : root.focused ? Theme.focus : Theme.line;
            border-radius: Size.radius-control;
        }

        HorizontalLayout {
            padding-left: Size.field-pad-x;
            padding-right: Size.segment-inset;
            spacing: Size.space-4;

            VerticalLayout {
                alignment: center;

                Icon {
                    source: Icons.search;
                    size: IconSize.normal;
                    tone: InkTone.faint;
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                if root.text == "": Label {
                    width: parent.width;
                    height: parent.height;
                    text: root.placeholder;
                    tone: InkTone.faint;
                    accessible-role: none;
                }
                entry := TextEntry {
                    width: parent.width;
                    height: parent.height;
                    text <=> root.text;
                    // A regular expression is read in the mono step (§ 5.4).
                    step: root.regex ? TypeStep.mono : TypeStep.body;
                    enabled: root.enabled;
                    label: root.placeholder;
                    edited => {
                        rest.running = false;
                        rest.running = true;
                    }
                    accepted => {
                        root.apply();
                    }
                }
            }

            if root.text != "": VerticalLayout {
                alignment: center;

                Button {
                    icon: Icons.x;
                    variant: ButtonVariant.ghost;
                    size: ButtonSize.small;
                    accessible-label: @tr("Clear the search");
                    clicked => {
                        root.text = "";
                        root.apply();
                        entry.focus();
                    }
                }
            }

            VerticalLayout {
                alignment: center;

                ToggleButton {
                    icon: Icons.case-sensitive;
                    size: ToggleSize.small;
                    checked <=> root.match-case;
                    enabled: root.enabled;
                    accessible-label: @tr("Match case");
                    toggled => {
                        root.apply();
                    }
                }
            }

            VerticalLayout {
                alignment: center;

                ToggleButton {
                    icon: Icons.regex;
                    size: ToggleSize.small;
                    checked <=> root.regex;
                    enabled: root.enabled;
                    accessible-label: @tr("Regular expression");
                    toggled => {
                        root.apply();
                    }
                }
            }
        }
    }

    if root.focused && (root.kit-state == KitState.focus || InputMode.keyboard): FocusRing {
        radius: Size.radius-control;
    }

    rest := Timer {
        interval: Motion.search-rest;
        running: false;
        triggered => {
            root.apply();
        }
    }
}

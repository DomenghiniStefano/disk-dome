// ProgressBar (§ 5.21): the scan line under the toolbar, as Radix's Progress. `progress-h` tall, `accent` on a
// transparent track, as wide as its layout gives it. Determinate (the MFT size known), it fills `value` of `maximum`
// from the start and eases to each new value (`base`, § 3.10); indeterminate, a segment `progress-segment` of the
// track slides across it from just off the start to just off the end, at an even pace, every `progress-sweep`
// (`slow` × 6), and with reduced motion it stays still over the start. The software renderer draws no scale: the
// fill changes its width and the segment its `x`, clipped by the track. It shows, it takes no pointer and no focus.

import { Size } from "../tokens/size.slint";
import { Theme } from "../tokens/theme.slint";
import { Motion } from "../tokens/motion.slint";
import { ProgressBarMode, ProgressBarState } from "../enums.slint";
import { BarValue } from "../primitives/bar-value.slint";

export component ProgressBar {
    // How far along, out of `maximum` (Radix's default, 100). Outside 0…maximum the bar shows empty or full.
    in property <float> value;
    in property <float> maximum: 100;
    in property <ProgressBarMode> mode: ProgressBarMode.determinate;
    // What a screen reader calls the bar («Analysis of C:»); nothing is drawn.
    in property <string> label;
    // What a screen reader says as the value instead of the number («1.2 of 4.2 GB»), as Radix's `getValueLabel`.
    in property <string> value-label;
    in property <length> thickness: Size.progress-h;
    in property <color> fill-color: Theme.accent;
    in property <color> track-color: transparent;
    // The share of the track the indeterminate segment covers, and the time it takes to cross it.
    in property <float> segment: Size.progress-segment;
    in property <duration> sweep: Motion.progress-sweep;
    // How long the fill takes to reach a new value.
    in property <duration> ease-duration: Motion.base;

    out property <ProgressBarState> state: root.mode == ProgressBarMode.indeterminate ? ProgressBarState.indeterminate
        : root.ratio >= 1 ? ProgressBarState.complete
        : ProgressBarState.loading;
    // What a screen reader says as the value: nothing while indeterminate (the tests read it).
    out property <string> said-value: root.mode == ProgressBarMode.indeterminate ? "" : BarValue.said(root.value, root.maximum, root.value-label);
    // How wide the determinate fill is drawn, mid-ease included (the tests read it).
    out property <length> fill-width: fill.width;
    out property <length> segment-width: root.width * root.segment;
    // Where the indeterminate segment is, from the track's start: it crosses from `-segment-width` to the track's end
    // and starts over; with no time to cross in (reduced motion) it stays at the start. The segment sits inside an
    // `if`, so its place is computed here, where the tests can read it.
    out property <length> segment-x: root.mode == ProgressBarMode.indeterminate && root.sweep / Motion.unit > 0
        ? -root.segment-width + (root.width + root.segment-width) * (mod(animation-tick(), root.sweep) / root.sweep)
        : 0;

    property <float> ratio: BarValue.ratio(root.value, root.maximum);
    // The share drawn: it eases to each new value rather than jumping.
    property <float> shown: root.ratio;
    animate shown {
        duration: root.ease-duration;
        easing: Motion.ease-out;
    }

    height: root.thickness;
    preferred-width: Size.bar-w;
    horizontal-stretch: 1;
    vertical-stretch: 0;

    accessible-role: progress-indicator;
    accessible-label: root.label;
    accessible-value: root.said-value;
    accessible-value-minimum: 0;
    accessible-value-maximum: max(root.maximum, 0);

    Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: root.track-color;
        clip: true;

        fill := Rectangle {
            x: 0;
            y: 0;
            width: root.width * root.shown;
            height: root.height;
            visible: root.mode == ProgressBarMode.determinate;
            background: root.fill-color;
        }

        if root.mode == ProgressBarMode.indeterminate: Rectangle {
            x: root.segment-x;
            y: 0;
            width: root.segment-width;
            height: root.height;
            background: root.fill-color;
        }
    }
}

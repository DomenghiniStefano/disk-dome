// The components' variants and sizes (`docs/design-system.md` § 5). Variants are enums, never strings (§ 3.1).
// `TypeStep` lives with the type tokens (`tokens/type.slint`).

// The colour role of a text or an icon (§ 5.1). `on-data` needs the category it sits on.
export enum InkTone { normal, muted, faint, accent, danger, warning, success, on-accent, on-danger, on-data }

// How a single-line text that does not fit is shortened (§ 3.3). Slint elides only at the end: a `middle` text
// arrives already shortened from Rust, and is then cut at the end only if it still does not fit.
export enum Elide { none, end, middle }

// `small` 12, `normal` 16 / 14 (density), `hero` 18: only inside the hero button (§ 3.12, § 5.2).
export enum IconSize { small, normal, hero }

export enum ButtonVariant { primary, secondary, ghost, danger, danger-ghost }

// How wide a button is (§ 5.2): `hug` its content (and, short of room, down to its minimum with the label cut by
// «…»), or `fill` the width its layout gives it (a dialog's or a panel's full-width button).
export enum ButtonWidth { hug, fill }

// `hero`: only the call to action of an empty state, one per screen (§ 5.2).
export enum ButtonSize { small, normal, large, hero }

export enum SegmentedSize { small, normal }

// How wide a segmented control is (§ 5.6): `hug` its segments (and, short of room, down to their minimum with the
// labels cut by «…»), or `fill` the width its layout gives it, split equally between the segments.
export enum SegmentedWidth { hug, fill }

// Which toggles a search field holds on its right (§ 5.4): none (the command palette, the shortcuts dialog), match
// case only, or match case and regular expression (the files' search).
export enum SearchFieldToggles { none, match-case, match-case-and-regex }

// `small` sits inside a field (the search's `Aa` / `.*`), `normal` in a toolbar (§ 5.3).
export enum ToggleSize { small, normal }

// What a scroll bar draws at its ends (§ 5.24): no arrows (the default), arrows that appear while the bar is widened
// under the pointer (as Windows 11), or arrows always.
export enum ScrollBarArrows { none, on-hover, always }

// What a press on a scroll bar's track does (§ 5.24): `page` through the content towards the pointer, repeating while
// held (as Windows), or `jump` the thumb under the pointer, ready to drag (as Radix and macOS). Shift+click jumps.
export enum ScrollBarTrackClick { page, jump }

// When a scroll bar shows (§ 5.24): `scroll` while the content moves and while the pointer is over the bar (Radix's
// `type="scroll"`), `auto` whenever the content overflows, `always` even when it does not (track and arrows).
export enum ScrollBarVisibility { scroll, auto, always }

// The Kit window shows every state side by side (§ 9): a component shows the forced state instead of the
// pointer's and the keyboard's. Screens never set it; `live` is the real behaviour.
export enum KitState { live, hover, pressed, focus }

// What a menu entry is (§ 5.16): a plain item, an item with a check box or a radio dot (a group runs between
// separators or section titles), a separator line, or a section's overline title.
export enum MenuEntryKind { item, checkbox, radio, separator, section }

// `danger`: an item that cannot be undone, as «Delete permanently» (§ 6.3).
export enum MenuItemVariant { normal, danger }

// Which item a menu highlights when it opens: none (opened by the pointer), the first (↓, Enter, Space) or the last
// (↑), as Windows does.
export enum MenuStart { none, first, last }

// Where a popup opens around its anchor (§ 3.11). The side flips when the content does not fit there.
export enum PopupSide { bottom, top, right, left }

// How a popup lines up with its anchor along the side it opens on: on the anchor's start edge, centred, or on its
// end edge (the right edge for a button at the right of the window).
export enum PopupAlign { start, center, end }
